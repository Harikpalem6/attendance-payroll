<!DOCTYPE html>
<html>
<head>
    <title>Dashboard</title>
    <link rel="stylesheet" href="/css/style.css">

    <style>
        .chart-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 20px;
        }

        .chart-card {
            background: #ffffff;
            border-radius: 12px;
            padding: 18px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        }

        .bar-row {
            margin-bottom: 14px;
        }

        .bar-label {
            display: flex;
            justify-content: space-between;
            font-weight: bold;
            margin-bottom: 6px;
            font-size: 14px;
        }

        .bar-bg {
            width: 100%;
            height: 16px;
            background: #e9e9e9;
            border-radius: 20px;
            overflow: hidden;
        }

        .bar-fill {
            height: 100%;
            background: #333;
            border-radius: 20px;
        }

        .mini-badge {
            display: inline-block;
            padding: 4px 8px;
            border-radius: 12px;
            background: #f2f2f2;
            font-size: 12px;
            margin-left: 6px;
        }
    </style>
</head>
<body>

<div class="app-layout">

    <aside class="sidebar">
        <h2>HRMS</h2>

        <nav>
    <a href="/dashboard">Dashboard</a>

    <% if (user && (user.role === "Super Admin" || user.role === "HR")) { %>
        <a href="/employees">Employees</a>
    <% } %>

    <% if (user && (user.role === "Super Admin" || user.role === "HR" || user.role === "Manager")) { %>
        <a href="/attendance">Attendance</a>
        <a href="/attendance/monthly-report">Monthly Report</a>
        <a href="/attendance/regularizations">Regularizations</a>
        <a href="/leaves">Leaves</a>
        <a href="/leaves/balances">Leave Balances</a>
    <% } %>

    <% if (user && user.role === "Super Admin") { %>
        <a href="/payroll">Payroll</a>
        <a href="/admin-users">Admin Users</a>
        <a href="/company-settings">Company Settings</a>
        <a href="/activity-logs">Activity Logs</a>
        <a href="/export/backup">Download Backup</a>
    <% } %>

    <a href="/change-password">Change Password</a>
    <a href="/logout">Logout</a>
</nav>
    </aside>

    <main class="content">

        <h1>Dashboard</h1>

        <div class="stats-grid">

            <div class="card">
                <h2>Total Employees</h2>
                <p><%= totalEmployees %></p>
            </div>

            <div class="card">
                <h2>Present Today</h2>
                <p><%= presentToday %></p>
            </div>

            <div class="card">
                <h2>Absent Today</h2>
                <p><%= absentToday %></p>
            </div>

            <div class="card">
                <h2>Half Day Today</h2>
                <p><%= halfDayToday || 0 %></p>
            </div>

        </div>

        <br>

        <h2>Dashboard Charts</h2>

        <br>

        <div class="chart-grid">

            <div class="chart-card">
                <h3>Today Attendance</h3>

                <br>

                <% 
                    const attendanceTotal = Number(presentToday || 0) + Number(absentToday || 0) + Number(halfDayToday || 0);
                    const presentPercent = attendanceTotal > 0 ? (Number(presentToday || 0) / attendanceTotal) * 100 : 0;
                    const absentPercent = attendanceTotal > 0 ? (Number(absentToday || 0) / attendanceTotal) * 100 : 0;
                    const halfDayPercent = attendanceTotal > 0 ? (Number(halfDayToday || 0) / attendanceTotal) * 100 : 0;
                %>

                <div class="bar-row">
                    <div class="bar-label">
                        <span>Present</span>
                        <span><%= presentToday %></span>
                    </div>
                    <div class="bar-bg">
                        <div class="bar-fill" style="width:<%= presentPercent %>%"></div>
                    </div>
                </div>

                <div class="bar-row">
                    <div class="bar-label">
                        <span>Absent</span>
                        <span><%= absentToday %></span>
                    </div>
                    <div class="bar-bg">
                        <div class="bar-fill" style="width:<%= absentPercent %>%"></div>
                    </div>
                </div>

                <div class="bar-row">
                    <div class="bar-label">
                        <span>Half Day</span>
                        <span><%= halfDayToday || 0 %></span>
                    </div>
                    <div class="bar-bg">
                        <div class="bar-fill" style="width:<%= halfDayPercent %>%"></div>
                    </div>
                </div>
            </div>

            <div class="chart-card">
                <h3>Leave Status</h3>

                <br>

                <% 
                    const leaveTotal = Number(pendingLeaves || 0) + Number(approvedLeaves || 0) + Number(rejectedLeaves || 0);
                    const pendingPercent = leaveTotal > 0 ? (Number(pendingLeaves || 0) / leaveTotal) * 100 : 0;
                    const approvedPercent = leaveTotal > 0 ? (Number(approvedLeaves || 0) / leaveTotal) * 100 : 0;
                    const rejectedPercent = leaveTotal > 0 ? (Number(rejectedLeaves || 0) / leaveTotal) * 100 : 0;
                %>

                <div class="bar-row">
                    <div class="bar-label">
                        <span>Pending</span>
                        <span><%= pendingLeaves || 0 %></span>
                    </div>
                    <div class="bar-bg">
                        <div class="bar-fill" style="width:<%= pendingPercent %>%"></div>
                    </div>
                </div>

                <div class="bar-row">
                    <div class="bar-label">
                        <span>Approved</span>
                        <span><%= approvedLeaves || 0 %></span>
                    </div>
                    <div class="bar-bg">
                        <div class="bar-fill" style="width:<%= approvedPercent %>%"></div>
                    </div>
                </div>

                <div class="bar-row">
                    <div class="bar-label">
                        <span>Rejected</span>
                        <span><%= rejectedLeaves || 0 %></span>
                    </div>
                    <div class="bar-bg">
                        <div class="bar-fill" style="width:<%= rejectedPercent %>%"></div>
                    </div>
                </div>
            </div>

            <div class="chart-card">
                <h3>Employees by Department</h3>

                <br>

                <% 
                    let maxDepartmentCount = 0;

                    if (departmentSummary && departmentSummary.length > 0) {
                        departmentSummary.forEach(item => {
                            if (Number(item.count) > maxDepartmentCount) {
                                maxDepartmentCount = Number(item.count);
                            }
                        });
                    }
                %>

                <% if (departmentSummary && departmentSummary.length > 0) { %>
                    <% departmentSummary.forEach(item => { %>
                        <% const deptPercent = maxDepartmentCount > 0 ? (Number(item.count) / maxDepartmentCount) * 100 : 0; %>

                        <div class="bar-row">
                            <div class="bar-label">
                                <span><%= item.department || 'Not Assigned' %></span>
                                <span><%= item.count %></span>
                            </div>
                            <div class="bar-bg">
                                <div class="bar-fill" style="width:<%= deptPercent %>%"></div>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <p>No department data found.</p>
                <% } %>
            </div>

        </div>

        <br>

        <div class="card">
            <div style="display:flex; justify-content:space-between; align-items:center;">
                <h2>Recent Admin Notifications</h2>

                <form action="/notifications/read-all" method="POST">
                    <button type="submit" class="secondary-btn">
                        Mark All Read
                    </button>
                </form>
            </div>

            <br>

            <table>
                <tr>
                    <th>Status</th>
                    <th>Title</th>
                    <th>Message</th>
                    <th>Date / Time</th>
                    <th>Action</th>
                </tr>

                <% if (notifications && notifications.length > 0) { %>
                    <% notifications.forEach(notification => { %>
                        <tr style="<%= notification.is_read ? '' : 'font-weight:bold; background:#f7f7f7;' %>">
                            <td>
                                <%= notification.is_read ? 'Read' : 'Unread' %>
                            </td>

                            <td><%= notification.title || '-' %></td>

                            <td><%= notification.message || '-' %></td>

                            <td>
                                <%= notification.created_at ? new Date(notification.created_at).toLocaleString() : '' %>
                            </td>

                            <td>
                                <% if (notification.is_read) { %>
                                    <form action="/notifications/unread/<%= notification.id %>" method="POST">
                                        <button type="submit" class="secondary-btn">
                                            Mark Unread
                                        </button>
                                    </form>
                                <% } else { %>
                                    <form action="/notifications/read/<%= notification.id %>" method="POST">
                                        <button type="submit" class="secondary-btn">
                                            Mark Read
                                        </button>
                                    </form>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="5">No notifications yet.</td>
                    </tr>
                <% } %>
            </table>
        </div>

    </main>

</div>

</body>
</html>