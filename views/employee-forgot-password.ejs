<!DOCTYPE html>
<html>
<head>
    <title>Employee Forgot Password</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<div class="content" style="max-width:600px; margin:50px auto;">

    <div class="card">

        <h1>Employee Forgot Password</h1>

        <% if (error) { %>
            <p style="color:red;"><%= error %></p>
        <% } %>

        <% if (success) { %>
            <p style="color:green;"><%= success %></p>
        <% } %>

        <form action="/employee/forgot-password" method="POST" class="stack-form">

            <label>Username</label>
            <input type="text" name="username" placeholder="Enter employee username">

            <label>Email</label>
            <input type="email" name="email" placeholder="Enter employee email">

            <label>Message</label>
            <input type="text" name="message" placeholder="Optional message">

            <button type="submit">Submit Reset Request</button>

        </form>

        <br>

        <a href="/employee/login">Back to Employee Login</a>

    </div>

</div>

</body>
</html>