<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#0f172a">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="VLCG HRMS">

    <title>Employee Login - VLCG HRMS</title>
    <link rel="stylesheet" href="/css/style.css">

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            background: linear-gradient(135deg, #dcfce7, #f8fafc);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: Arial, sans-serif;
            padding: 18px;
        }

        .login-box {
            width: 100%;
            max-width: 410px;
            background: #ffffff;
            padding: 34px 28px;
            border-radius: 18px;
            box-shadow: 0 12px 35px rgba(15, 23, 42, 0.16);
            text-align: center;
        }

        .app-logo {
            width: 78px;
            height: 78px;
            border-radius: 20px;
            object-fit: cover;
            margin-bottom: 14px;
            background: #0f172a;
        }

        .login-box h1 {
            margin: 0 0 8px;
            color: #111827;
            font-size: 27px;
            font-weight: 700;
        }

        .login-box p {
            margin: 0 0 25px;
            color: #4b5563;
            font-size: 15px;
        }

        .error-message {
            background: #fee2e2;
            color: #991b1b;
            padding: 11px 12px;
            border-radius: 10px;
            margin-bottom: 16px;
            font-size: 14px;
            text-align: left;
        }

        .form-group {
            margin-bottom: 14px;
        }

        .login-box input {
            width: 100%;
            padding: 14px 13px;
            border: 1px solid #cbd5e1;
            border-radius: 10px;
            font-size: 15px;
            outline: none;
            background: #ffffff;
        }

        .login-box input:focus {
            border-color: #16a34a;
            box-shadow: 0 0 0 3px rgba(22, 163, 74, 0.12);
        }

        .login-btn {
            width: 100%;
            padding: 14px;
            border: none;
            border-radius: 10px;
            background: #16a34a;
            color: #ffffff;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            margin-top: 4px;
        }

        .login-btn:hover {
            background: #15803d;
        }

        .install-app-box {
            margin-top: 14px;
        }

        .install-app-btn {
            display: none;
            width: 100%;
            padding: 13px 16px;
            border: none;
            border-radius: 10px;
            background: #0f172a;
            color: #ffffff;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
        }

        .install-app-btn:hover {
            background: #1e293b;
        }

        .login-links {
            margin-top: 20px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .login-links a {
            color: #16a34a;
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
        }

        .login-links a:hover {
            text-decoration: underline;
        }

        .footer-note {
            margin-top: 22px;
            font-size: 12px;
            color: #94a3b8;
        }

        @media (max-width: 480px) {
            body {
                align-items: flex-start;
                padding-top: 35px;
            }

            .login-box {
                padding: 28px 22px;
                border-radius: 16px;
            }

            .login-box h1 {
                font-size: 24px;
            }

            .app-logo {
                width: 68px;
                height: 68px;
            }
        }
    </style>
</head>
<body>

<div class="login-box">

    <img src="/icons/icon-192.png" alt="VLCG HRMS" class="app-logo">

    <h1>Employee Login</h1>

    <p>VLCG HRMS Employee Portal</p>

    <% if (typeof error !== "undefined" && error) { %>
        <div class="error-message">
            <%= error %>
        </div>
    <% } %>

    <form action="/employee/login" method="POST">

        <div class="form-group">
            <input
                type="text"
                name="username"
                placeholder="Employee Username"
                autocomplete="username"
                required
            >
        </div>

        <div class="form-group">
            <input
                type="password"
                name="password"
                placeholder="Password"
                autocomplete="current-password"
                required
            >
        </div>

        <button type="submit" class="login-btn">
            Login
        </button>

    </form>

    <div class="install-app-box">
        <button id="installAppBtn" class="install-app-btn">
            Install VLCG HRMS App
        </button>
    </div>

    <div class="login-links">
        <a href="/employee/forgot-password">Forgot Password?</a>
        <a href="/">Admin / HR Login</a>
    </div>

    <div class="footer-note">
        Employee Self Service Portal
    </div>

</div>

<script>
    let deferredPrompt;
    const installAppBtn = document.getElementById("installAppBtn");

    window.addEventListener("beforeinstallprompt", function (event) {
        event.preventDefault();
        deferredPrompt = event;

        if (installAppBtn) {
            installAppBtn.style.display = "block";
        }
    });

    if (installAppBtn) {
        installAppBtn.addEventListener("click", async function () {
            if (!deferredPrompt) {
                return;
            }

            deferredPrompt.prompt();

            await deferredPrompt.userChoice;

            deferredPrompt = null;
            installAppBtn.style.display = "none";
        });
    }

    window.addEventListener("appinstalled", function () {
        if (installAppBtn) {
            installAppBtn.style.display = "none";
        }

        console.log("VLCG HRMS app installed");
    });

    if ("serviceWorker" in navigator) {
        window.addEventListener("load", function () {
            navigator.serviceWorker.register("/service-worker.js")
                .then(function () {
                    console.log("VLCG HRMS service worker registered");
                })
                .catch(function (error) {
                    console.log("Service worker registration failed:", error);
                });
        });
    }
</script>

</body>
</html>