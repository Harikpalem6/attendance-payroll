<!DOCTYPE html>
<html>
<head>
    <link rel="manifest" href="/manifest.json">
<meta name="theme-color" content="#0f172a">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="VLCG HRMS">

    <title>HRMS Login</title>
    <link rel="stylesheet" href="/css/style.css">

    <style>
        body {
            margin: 0;
            min-height: 100vh;
            background: #f3f6fb;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: Arial, sans-serif;
        }

        .login-box {
            width: 380px;
            background: #ffffff;
            padding: 35px;
            border-radius: 14px;
            box-shadow: 0 8px 25px rgba(0,0,0,0.12);
            text-align: center;
        }

        .login-box h1 {
            margin-bottom: 8px;
            color: #111827;
        }

        .login-box p {
            margin-bottom: 25px;
            color: #4b5563;
        }

        .login-box input {
            width: 100%;
            padding: 13px;
            margin-bottom: 14px;
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            font-size: 15px;
            box-sizing: border-box;
        }

        .login-box button {
            width: 100%;
            padding: 13px;
            border: none;
            border-radius: 8px;
            background: #2563eb;
            color: white;
            font-size: 16px;
            cursor: pointer;
        }

        .login-box button:hover {
            background: #1d4ed8;
        }

        .login-links {
            margin-top: 18px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .login-links a {
            color: #2563eb;
            text-decoration: none;
            font-size: 14px;
        }

        .login-links a:hover {
            text-decoration: underline;
        }

        .error-message {
            color: red;
            margin-bottom: 15px;
        }
    </style>
</head>
<body>

<div class="login-box">

    <h1>HRMS Login</h1>

    <p>Admin / HR / Manager Login</p>

    <% if (typeof error !== "undefined" && error) { %>
        <div class="error-message">
            <%= error %>
        </div>
    <% } %>

    <form action="/login" method="POST">

        <input
            type="text"
            name="username"
            placeholder="Username"
            required
        >

        <input
            type="password"
            name="password"
            placeholder="Password"
            required
        >

        <button type="submit">
            Login
        </button>

    </form>

    <div class="login-links">
        <a href="/forgot-password">Forgot Password?</a>
        <a href="/employee/login">Employee Login</a>
    </div>

</div>

<script>
  if ("serviceWorker" in navigator) {
    window.addEventListener("load", function () {
      navigator.serviceWorker.register("/service-worker.js")
        .then(function () {
          console.log("VLCG HRMS service worker registered");
        })
        .catch(function (error) {
          console.log("Service worker registration failed:", error);
        });
    });
  }
</script>

<style>
  .install-app-box {
    margin-top: 18px;
    text-align: center;
  }

  .install-app-btn {
    display: none;
    width: 100%;
    padding: 12px 16px;
    border: none;
    border-radius: 10px;
    background: #0f172a;
    color: #ffffff;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
  }

  .install-app-btn:hover {
    background: #1e293b;
  }
</style>

<div class="install-app-box">
  <button id="installAppBtn" class="install-app-btn">
    Install VLCG HRMS App
  </button>
</div>

<script>
  let deferredPrompt;
  const installAppBtn = document.getElementById("installAppBtn");

  window.addEventListener("beforeinstallprompt", function (event) {
    event.preventDefault();
    deferredPrompt = event;

    if (installAppBtn) {
      installAppBtn.style.display = "block";
    }
  });

  if (installAppBtn) {
    installAppBtn.addEventListener("click", async function () {
      if (!deferredPrompt) {
        return;
      }

      deferredPrompt.prompt();

      const choiceResult = await deferredPrompt.userChoice;

      deferredPrompt = null;
      installAppBtn.style.display = "none";
    });
  }

  window.addEventListener("appinstalled", function () {
    if (installAppBtn) {
      installAppBtn.style.display = "none";
    }

    console.log("VLCG HRMS app installed");
  });

  if ("serviceWorker" in navigator) {
    window.addEventListener("load", function () {
      navigator.serviceWorker.register("/service-worker.js")
        .then(function () {
          console.log("VLCG HRMS service worker registered");
        })
        .catch(function (error) {
          console.log("Service worker registration failed:", error);
        });
    });
  }
</script>

</body>
</html>