<!DOCTYPE html>
<html>
<head>
    <title>Payroll Management</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<div class="app-layout">

    <aside class="sidebar">
        <h2>HRMS</h2>

        <nav>
            <a href="/dashboard">Dashboard</a>

            <% if (user && (user.role === "Super Admin" || user.role === "HR")) { %>
                <a href="/employees">Employees</a>
            <% } %>

            <% if (user && (user.role === "Super Admin" || user.role === "HR" || user.role === "Manager")) { %>
                <a href="/attendance">Attendance</a>
                <a href="/attendance/monthly-report">Monthly Report</a>
                <a href="/leaves">Leaves</a>
                <a href="/leaves/balances">Leave Balances</a>
            <% } %>

            <% if (user && user.role === "Super Admin") { %>
                <a href="/payroll">Payroll</a>
                <a href="/admin-users">Admin Users</a>
                <a href="/company-settings">Company Settings</a>
                <a href="/activity-logs">Activity Logs</a>
                <a href="/export/backup">Download Backup</a>
            <% } %>

            <a href="/logout">Logout</a>
        </nav>
    </aside>

    <main class="content">

        <h1>Payroll Management</h1>

        <form action="/payroll/calculate" method="POST" class="toolbar">

            <select name="employee_id" required>
                <option value="">Select Employee</option>

                <% employees.forEach(emp => { %>
                    <option value="<%= emp.id %>">
                        <%= emp.name %>
                    </option>
                <% }) %>
            </select>

            <input type="month" name="month" required>

            <button type="submit">Calculate Payroll</button>

        </form>

        <% if (payroll) { %>

        <div class="card">

            <h2>Payroll Result</h2>

            <br>

            <p><strong>Employee:</strong> <%= payroll.employee.name %></p>
            <p><strong>Department:</strong> <%= payroll.employee.department || '-' %></p>
            <p><strong>Month:</strong> <%= payroll.month %></p>

            <br>

            <h3>Earnings</h3>

            <p><strong>Basic Salary:</strong> Rs. <%= payroll.basicSalary.toFixed(2) %></p>
            <p><strong>HRA:</strong> Rs. <%= payroll.hra.toFixed(2) %></p>
            <p><strong>Allowances:</strong> Rs. <%= payroll.allowances.toFixed(2) %></p>
            <p><strong>Bonus:</strong> Rs. <%= payroll.bonus.toFixed(2) %></p>
            <p><strong>Gross Salary:</strong> Rs. <%= payroll.grossSalary.toFixed(2) %></p>

            <br>

            <h3>Attendance</h3>

            <p><strong>Present Days:</strong> <%= payroll.present %></p>
            <p><strong>Absent Days:</strong> <%= payroll.absent %></p>
            <p><strong>Half Days:</strong> <%= payroll.halfday %></p>
            <p><strong>Attendance Deduction:</strong> Rs. <%= payroll.attendanceDeduction.toFixed(2) %></p>

            <br>

            <h3>Deductions</h3>

            <p><strong>PF Deduction:</strong> Rs. <%= payroll.pfDeduction.toFixed(2) %></p>
            <p><strong>ESI Deduction:</strong> Rs. <%= payroll.esiDeduction.toFixed(2) %></p>
            <p><strong>Professional Tax:</strong> Rs. <%= payroll.professionalTax.toFixed(2) %></p>
            <p><strong>Other Deduction:</strong> Rs. <%= payroll.otherDeduction.toFixed(2) %></p>
            <p><strong>Total Deductions:</strong> Rs. <%= payroll.deduction.toFixed(2) %></p>

            <br>

            <h3>Net Salary</h3>

            <p><strong>Final Salary:</strong> Rs. <%= payroll.finalSalary.toFixed(2) %></p>

            <br>

            <form action="/payroll/save" method="POST" style="display:inline-block; margin-right:10px;">

                <input type="hidden" name="employee_id" value="<%= payroll.employee.id %>">
                <input type="hidden" name="month" value="<%= payroll.month %>">

                <input type="hidden" name="base_salary" value="<%= payroll.grossSalary.toFixed(2) %>">
                <input type="hidden" name="basic_salary" value="<%= payroll.basicSalary.toFixed(2) %>">
                <input type="hidden" name="hra" value="<%= payroll.hra.toFixed(2) %>">
                <input type="hidden" name="allowances" value="<%= payroll.allowances.toFixed(2) %>">
                <input type="hidden" name="bonus" value="<%= payroll.bonus.toFixed(2) %>">

                <input type="hidden" name="pf_deduction" value="<%= payroll.pfDeduction.toFixed(2) %>">
                <input type="hidden" name="esi_deduction" value="<%= payroll.esiDeduction.toFixed(2) %>">
                <input type="hidden" name="professional_tax" value="<%= payroll.professionalTax.toFixed(2) %>">
                <input type="hidden" name="other_deduction" value="<%= payroll.otherDeduction.toFixed(2) %>">

                <input type="hidden" name="present_days" value="<%= payroll.present %>">
                <input type="hidden" name="absent_days" value="<%= payroll.absent %>">
                <input type="hidden" name="half_days" value="<%= payroll.halfday %>">
                <input type="hidden" name="deduction" value="<%= payroll.deduction.toFixed(2) %>">
                <input type="hidden" name="final_salary" value="<%= payroll.finalSalary.toFixed(2) %>">

                <button type="submit">
                    Save Payroll Record
                </button>

            </form>

            <form action="/payroll/payslip" method="POST" style="display:inline-block; margin-right:10px;">

                <input type="hidden" name="employeeName" value="<%= payroll.employee.name %>">
                <input type="hidden" name="department" value="<%= payroll.employee.department || '' %>">
                <input type="hidden" name="email" value="<%= payroll.employee.email || '' %>">
                <input type="hidden" name="photo_path" value="<%= payroll.employee.photo_path || '' %>">

                <input type="hidden" name="salary" value="<%= payroll.grossSalary.toFixed(2) %>">
                <input type="hidden" name="basicSalary" value="<%= payroll.basicSalary.toFixed(2) %>">
                <input type="hidden" name="hra" value="<%= payroll.hra.toFixed(2) %>">
                <input type="hidden" name="allowances" value="<%= payroll.allowances.toFixed(2) %>">
                <input type="hidden" name="bonus" value="<%= payroll.bonus.toFixed(2) %>">

                <input type="hidden" name="grossSalary" value="<%= payroll.grossSalary.toFixed(2) %>">
                <input type="hidden" name="attendanceDeduction" value="<%= payroll.attendanceDeduction.toFixed(2) %>">
                <input type="hidden" name="pfDeduction" value="<%= payroll.pfDeduction.toFixed(2) %>">
                <input type="hidden" name="esiDeduction" value="<%= payroll.esiDeduction.toFixed(2) %>">
                <input type="hidden" name="professionalTax" value="<%= payroll.professionalTax.toFixed(2) %>">
                <input type="hidden" name="otherDeduction" value="<%= payroll.otherDeduction.toFixed(2) %>">

                <input type="hidden" name="present" value="<%= payroll.present %>">
                <input type="hidden" name="absent" value="<%= payroll.absent %>">
                <input type="hidden" name="halfday" value="<%= payroll.halfday %>">
                <input type="hidden" name="deduction" value="<%= payroll.deduction.toFixed(2) %>">
                <input type="hidden" name="finalSalary" value="<%= payroll.finalSalary.toFixed(2) %>">
                <input type="hidden" name="month" value="<%= payroll.month %>">

                <button type="submit">
                    Download PDF Payslip
                </button>

            </form>

            <form action="/payroll/email-payslip" method="POST" style="display:inline-block;">

                <input type="hidden" name="employeeName" value="<%= payroll.employee.name %>">
                <input type="hidden" name="department" value="<%= payroll.employee.department || '' %>">
                <input type="hidden" name="email" value="<%= payroll.employee.email || '' %>">
                <input type="hidden" name="photo_path" value="<%= payroll.employee.photo_path || '' %>">

                <input type="hidden" name="salary" value="<%= payroll.grossSalary.toFixed(2) %>">
                <input type="hidden" name="basicSalary" value="<%= payroll.basicSalary.toFixed(2) %>">
                <input type="hidden" name="hra" value="<%= payroll.hra.toFixed(2) %>">
                <input type="hidden" name="allowances" value="<%= payroll.allowances.toFixed(2) %>">
                <input type="hidden" name="bonus" value="<%= payroll.bonus.toFixed(2) %>">

                <input type="hidden" name="grossSalary" value="<%= payroll.grossSalary.toFixed(2) %>">
                <input type="hidden" name="attendanceDeduction" value="<%= payroll.attendanceDeduction.toFixed(2) %>">
                <input type="hidden" name="pfDeduction" value="<%= payroll.pfDeduction.toFixed(2) %>">
                <input type="hidden" name="esiDeduction" value="<%= payroll.esiDeduction.toFixed(2) %>">
                <input type="hidden" name="professionalTax" value="<%= payroll.professionalTax.toFixed(2) %>">
                <input type="hidden" name="otherDeduction" value="<%= payroll.otherDeduction.toFixed(2) %>">

                <input type="hidden" name="present" value="<%= payroll.present %>">
                <input type="hidden" name="absent" value="<%= payroll.absent %>">
                <input type="hidden" name="halfday" value="<%= payroll.halfday %>">
                <input type="hidden" name="deduction" value="<%= payroll.deduction.toFixed(2) %>">
                <input type="hidden" name="finalSalary" value="<%= payroll.finalSalary.toFixed(2) %>">
                <input type="hidden" name="month" value="<%= payroll.month %>">

                <button type="submit">
                    Email Payslip
                </button>

            </form>

        </div>

        <br>

        <% } %>

        <h2>Payroll History</h2>

        <br>

        <table>
            <tr>
                <th>ID</th>
                <th>Employee</th>
                <th>Month</th>
                <th>Gross Salary</th>
                <th>Present</th>
                <th>Absent</th>
                <th>Half Days</th>
                <th>Deduction</th>
                <th>Net Salary</th>
                <th>Created</th>
                <th>PDF</th>
            </tr>

            <% if (history && history.length > 0) { %>
                <% history.forEach(record => { %>
                <tr>
                    <td><%= record.id %></td>
                    <td><%= record.name %></td>
                    <td><%= record.month %></td>
                    <td>Rs. <%= Number(record.base_salary || 0).toFixed(2) %></td>
                    <td><%= record.present_days %></td>
                    <td><%= record.absent_days %></td>
                    <td><%= record.half_days %></td>
                    <td>Rs. <%= Number(record.deduction || 0).toFixed(2) %></td>
                    <td>Rs. <%= Number(record.final_salary || 0).toFixed(2) %></td>
                    <td><%= record.created_at ? new Date(record.created_at).toLocaleString() : '' %></td>

                    <td>
                        <form action="/payroll/payslip" method="POST">

                            <input type="hidden" name="employeeName" value="<%= record.name %>">
                            <input type="hidden" name="department" value="">
                            <input type="hidden" name="salary" value="<%= Number(record.base_salary || 0).toFixed(2) %>">

                            <input type="hidden" name="basicSalary" value="<%= Number(record.basic_salary || 0).toFixed(2) %>">
                            <input type="hidden" name="hra" value="<%= Number(record.hra || 0).toFixed(2) %>">
                            <input type="hidden" name="allowances" value="<%= Number(record.allowances || 0).toFixed(2) %>">
                            <input type="hidden" name="bonus" value="<%= Number(record.bonus || 0).toFixed(2) %>">

                            <input type="hidden" name="grossSalary" value="<%= Number(record.base_salary || 0).toFixed(2) %>">
                            <input type="hidden" name="attendanceDeduction" value="0">
                            <input type="hidden" name="pfDeduction" value="<%= Number(record.pf_deduction || 0).toFixed(2) %>">
                            <input type="hidden" name="esiDeduction" value="<%= Number(record.esi_deduction || 0).toFixed(2) %>">
                            <input type="hidden" name="professionalTax" value="<%= Number(record.professional_tax || 0).toFixed(2) %>">
                            <input type="hidden" name="otherDeduction" value="<%= Number(record.other_deduction || 0).toFixed(2) %>">

                            <input type="hidden" name="present" value="<%= record.present_days %>">
                            <input type="hidden" name="absent" value="<%= record.absent_days %>">
                            <input type="hidden" name="halfday" value="<%= record.half_days %>">
                            <input type="hidden" name="deduction" value="<%= Number(record.deduction || 0).toFixed(2) %>">
                            <input type="hidden" name="finalSalary" value="<%= Number(record.final_salary || 0).toFixed(2) %>">
                            <input type="hidden" name="month" value="<%= record.month %>">

                            <button type="submit">PDF</button>
                        </form>
                    </td>
                </tr>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="11">No payroll records saved yet.</td>
                </tr>
            <% } %>

        </table>

    </main>

</div>

</body>
</html>