<!DOCTYPE html>
<html>
<head>
    <title>Change Password</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<div class="app-layout">

    <aside class="sidebar">
        <h2>HRMS</h2>

        <nav>
            <a href="/dashboard">Dashboard</a>

            <% if (user && (user.role === "Super Admin" || user.role === "HR")) { %>
                <a href="/employees">Employees</a>
            <% } %>

            <% if (user && (user.role === "Super Admin" || user.role === "HR" || user.role === "Manager")) { %>
                <a href="/attendance">Attendance</a>
                <a href="/attendance/monthly-report">Monthly Report</a>
                <a href="/attendance/regularizations">Regularizations</a>
                <a href="/leaves">Leaves</a>
                <a href="/leaves/balances">Leave Balances</a>
            <% } %>

            <% if (user && user.role === "Super Admin") { %>
                <a href="/payroll">Payroll</a>
                <a href="/admin-users">Admin Users</a>
                <a href="/company-settings">Company Settings</a>
                <a href="/activity-logs">Activity Logs</a>
                <a href="/export/backup">Download Backup</a>
            <% } %>

            <a href="/change-password">Change Password</a>
            <a href="/logout">Logout</a>
        </nav>
    </aside>

    <main class="content">

        <h1>Change Password</h1>

        <div class="card">

            <% if (error) { %>
                <p style="color:red;"><%= error %></p>
            <% } %>

            <% if (success) { %>
                <p style="color:green;"><%= success %></p>
            <% } %>

            <form action="/change-password" method="POST" class="stack-form">

                <label>Current Password</label>
                <input type="password" name="current_password" required>

                <label>New Password</label>
                <input type="password" name="new_password" required>

                <label>Confirm New Password</label>
                <input type="password" name="confirm_password" required>

                <button type="submit">
                    Change Password
                </button>

            </form>

        </div>

    </main>

</div>

</body>
</html>