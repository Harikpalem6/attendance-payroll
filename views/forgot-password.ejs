<!DOCTYPE html>
<html>
<head>
    <title>Forgot Password</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<div class="content" style="max-width:600px; margin:50px auto;">

    <div class="card">

        <h1>Forgot Password</h1>
        <p>For Admin, HR, and Manager accounts.</p>

        <% if (error) { %>
            <p style="color:red;"><%= error %></p>
        <% } %>

        <% if (success) { %>
            <p style="color:green;"><%= success %></p>
        <% } %>

        <form action="/forgot-password" method="POST" class="stack-form">

            <label>Username</label>
            <input type="text" name="username" placeholder="Enter username">

            <label>Email</label>
            <input type="email" name="email" placeholder="Enter email">

            <label>Message</label>
            <input type="text" name="message" placeholder="Optional message">

            <button type="submit">Submit Reset Request</button>

        </form>

        <br>

        <a href="/">Back to Login</a>

    </div>

</div>

</body>
</html>