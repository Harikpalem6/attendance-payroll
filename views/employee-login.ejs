<!DOCTYPE html>
<html>
<head>
    <link rel="manifest" href="/manifest.json">
<meta name="theme-color" content="#0f172a">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="VLCG HRMS">

    <title>Employee Login</title>
    <link rel="stylesheet" href="/css/style.css">

    <style>
        body {
            margin: 0;
            min-height: 100vh;
            background: #f3f6fb;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: Arial, sans-serif;
        }

        .login-box {
            width: 380px;
            background: #ffffff;
            padding: 35px;
            border-radius: 14px;
            box-shadow: 0 8px 25px rgba(0,0,0,0.12);
            text-align: center;
        }

        .login-box h1 {
            margin-bottom: 8px;
            color: #111827;
        }

        .login-box p {
            margin-bottom: 25px;
            color: #4b5563;
        }

        .login-box input {
            width: 100%;
            padding: 13px;
            margin-bottom: 14px;
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            font-size: 15px;
            box-sizing: border-box;
        }

        .login-box button {
            width: 100%;
            padding: 13px;
            border: none;
            border-radius: 8px;
            background: #16a34a;
            color: white;
            font-size: 16px;
            cursor: pointer;
        }

        .login-box button:hover {
            background: #15803d;
        }

        .login-links {
            margin-top: 18px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .login-links a {
            color: #2563eb;
            text-decoration: none;
            font-size: 14px;
        }

        .login-links a:hover {
            text-decoration: underline;
        }

        .error-message {
            color: red;
            margin-bottom: 15px;
        }
    </style>
</head>
<body>

<div class="login-box">

    <h1>Employee Login</h1>

    <p>Employee Portal Access</p>

    <% if (typeof error !== "undefined" && error) { %>
        <div class="error-message">
            <%= error %>
        </div>
    <% } %>

    <form action="/employee/login" method="POST">

        <input
            type="text"
            name="username"
            placeholder="Employee Username"
            required
        >

        <input
            type="password"
            name="password"
            placeholder="Password"
            required
        >

        <button type="submit">
            Login
        </button>

    </form>

    <div class="login-links">
        <a href="/employee/forgot-password">Forgot Password?</a>
        <a href="/">Admin / HR / Manager Login</a>
    </div>

</div>

<script>
  if ("serviceWorker" in navigator) {
    window.addEventListener("load", function () {
      navigator.serviceWorker.register("/service-worker.js")
        .then(function () {
          console.log("VLCG HRMS service worker registered");
        })
        .catch(function (error) {
          console.log("Service worker registration failed:", error);
        });
    });
  }
</script>

</body>
</html>