<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#0f172a">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="VLCG HRMS">

    <title>Admin Users - VLCG HRMS</title>
    <link rel="stylesheet" href="/css/style.css">

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #f3f6fb;
            font-family: Arial, sans-serif;
            color: #111827;
        }

        .app-layout {
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            width: 250px;
            background: #0f172a;
            color: #ffffff;
            padding: 22px 18px;
            position: fixed;
            left: 0;
            top: 0;
            bottom: 0;
            overflow-y: auto;
            z-index: 1000;
        }

        .sidebar h2 {
            margin: 0 0 24px;
            font-size: 24px;
        }

        .sidebar nav {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .sidebar nav a {
            color: #e5e7eb;
            text-decoration: none;
            padding: 11px 12px;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 500;
        }

        .sidebar nav a:hover,
        .sidebar nav a.active {
            background: #1e293b;
            color: #ffffff;
        }

        .content {
            margin-left: 250px;
            width: calc(100% - 250px);
            padding: 24px;
        }

        .mobile-topbar {
            display: none;
            background: #0f172a;
            color: #ffffff;
            padding: 14px 16px;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 900;
        }

        .mobile-topbar h2 {
            margin: 0;
            font-size: 18px;
        }

        .menu-toggle {
            border: none;
            background: #1e293b;
            color: #ffffff;
            padding: 9px 14px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
        }

        .sidebar-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, 0.55);
            z-index: 950;
        }

        .page-header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 16px;
            margin-bottom: 22px;
        }

        .page-header h1 {
            margin: 0;
            font-size: 30px;
        }

        .page-header p {
            margin: 7px 0 0;
            color: #6b7280;
            font-size: 14px;
        }

        .role-badge {
            background: #ffffff;
            border-radius: 12px;
            padding: 10px 14px;
            box-shadow: 0 2px 8px rgba(15, 23, 42, 0.08);
            font-size: 14px;
            color: #374151;
            white-space: nowrap;
        }

        .role-pill {
            display: inline-block;
            margin-left: 6px;
            background: #dbeafe;
            color: #1d4ed8;
            padding: 5px 9px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 700;
        }

        .card,
        .toolbar-card {
            background: #ffffff;
            border-radius: 16px;
            padding: 18px;
            box-shadow: 0 4px 14px rgba(15, 23, 42, 0.08);
            margin-bottom: 22px;
        }

        .toolbar-title {
            margin: 0 0 14px;
            font-size: 20px;
            color: #111827;
        }

        .toolbar {
            display: grid;
            grid-template-columns: repeat(4, minmax(180px, 1fr));
            gap: 12px;
            align-items: end;
        }

        .toolbar input,
        .toolbar select {
            width: 100%;
            padding: 12px 13px;
            border: 1px solid #cbd5e1;
            border-radius: 10px;
            font-size: 15px;
            outline: none;
            background: #ffffff;
        }

        .toolbar input:focus,
        .toolbar select:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
        }

        .primary-btn,
        .secondary-btn,
        .delete-btn {
            border: none;
            border-radius: 10px;
            padding: 10px 13px;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            white-space: nowrap;
        }

        .primary-btn {
            background: #2563eb;
            color: #ffffff;
        }

        .primary-btn:hover {
            background: #1d4ed8;
        }

        .secondary-btn {
            background: #e5e7eb;
            color: #111827;
        }

        .secondary-btn:hover {
            background: #d1d5db;
        }

        .delete-btn {
            background: #dc2626;
            color: #ffffff;
        }

        .delete-btn:hover {
            background: #b91c1c;
        }

        .section-title {
            margin: 0 0 14px;
            font-size: 22px;
            color: #111827;
        }

        .table-wrap {
            width: 100%;
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 760px;
            background: #ffffff;
        }

        th,
        td {
            text-align: left;
            padding: 12px 10px;
            border-bottom: 1px solid #e5e7eb;
            font-size: 14px;
            vertical-align: top;
        }

        th {
            background: #f8fafc;
            color: #374151;
            font-weight: 700;
        }

        .username-text {
            font-weight: 700;
            color: #111827;
        }

        .admin-role-pill {
            display: inline-block;
            background: #eef2ff;
            color: #3730a3;
            padding: 6px 10px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 700;
        }

        .main-admin-pill {
            display: inline-block;
            background: #dcfce7;
            color: #166534;
            padding: 6px 10px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 700;
        }

        .action-buttons {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            min-width: 240px;
        }

        .action-buttons form {
            margin: 0;
        }

        .note-box {
            background: #fff7ed;
            color: #9a3412;
            border: 1px solid #fed7aa;
            padding: 13px 14px;
            border-radius: 12px;
            font-size: 14px;
            margin-top: 16px;
        }

        @media (max-width: 1100px) {
            .toolbar {
                grid-template-columns: repeat(2, minmax(180px, 1fr));
            }
        }

        @media (max-width: 768px) {
            .mobile-topbar {
                display: flex;
            }

            .app-layout {
                display: block;
            }

            .sidebar {
                transform: translateX(-100%);
                transition: transform 0.25s ease;
                width: 280px;
            }

            .sidebar.open {
                transform: translateX(0);
            }

            .sidebar-overlay.show {
                display: block;
            }

            .content {
                margin-left: 0;
                width: 100%;
                padding: 18px 14px 26px;
            }

            .page-header {
                flex-direction: column;
                align-items: flex-start;
            }

            .page-header h1 {
                font-size: 26px;
            }

            .role-badge {
                width: 100%;
                white-space: normal;
            }

            .card,
            .toolbar-card {
                padding: 16px;
                border-radius: 14px;
            }

            .toolbar {
                grid-template-columns: 1fr;
            }

            .toolbar button {
                width: 100%;
            }
        }
    </style>
</head>
<body>

<div class="mobile-topbar">
    <button type="button" class="menu-toggle" id="menuToggle">
        Menu
    </button>

    <h2>VLCG HRMS</h2>
</div>

<div class="sidebar-overlay" id="sidebarOverlay"></div>

<div class="app-layout">

    <aside class="sidebar" id="sidebar">
        <h2>HRMS</h2>

        <nav>
            <a href="/dashboard">Dashboard</a>

            <% if (user && (user.role === "Super Admin" || user.role === "HR")) { %>
                <a href="/employees">Employees</a>
            <% } %>

            <% if (user && (user.role === "Super Admin" || user.role === "HR")) { %>
                <a href="/password-reset-requests">Password Reset Requests</a>
            <% } %>

            <% if (user && (user.role === "Super Admin" || user.role === "HR" || user.role === "Manager")) { %>
                <a href="/attendance">Attendance</a>
                <a href="/attendance/monthly-report">Monthly Report</a>
                <a href="/attendance/regularizations">Regularizations</a>
                <a href="/leaves">Leaves</a>
                <a href="/leaves/balances">Leave Balances</a>
            <% } %>

            <% if (user && user.role === "Super Admin") { %>
                <a href="/payroll">Payroll</a>
                <a href="/admin-users" class="active">Admin Users</a>
                <a href="/company-settings">Company Settings</a>
                <a href="/activity-logs">Activity Logs</a>
                <a href="/export/backup">Download Backup</a>
            <% } %>

            <a href="/change-password">Change Password</a>
            <a href="/logout">Logout</a>
        </nav>
    </aside>

    <main class="content">

        <div class="page-header">
            <div>
                <h1>Admin User Management</h1>
                <p>Create admin, HR, and manager users. Reset passwords or remove non-main admin accounts.</p>
            </div>

            <div class="role-badge">
                Logged in as
                <strong><%= user && user.username ? user.username : "User" %></strong>

                <% if (user && user.role) { %>
                    <span class="role-pill"><%= user.role %></span>
                <% } %>
            </div>
        </div>

        <div class="toolbar-card">
            <h2 class="toolbar-title">Add Admin User</h2>

            <form action="/admin-users/add" method="POST" class="toolbar">
                <input
                    type="text"
                    name="username"
                    placeholder="Username"
                    autocomplete="username"
                    required
                >

                <input
                    type="password"
                    name="password"
                    placeholder="Password"
                    autocomplete="new-password"
                    required
                >

                <select name="role" required>
                    <option value="Super Admin">Super Admin</option>
                    <option value="HR">HR</option>
                    <option value="Manager">Manager</option>
                </select>

                <button type="submit" class="primary-btn">
                    Add User
                </button>
            </form>

            <div class="note-box">
                <strong>Note:</strong> Reset Password sets password to <strong>admin123</strong>.
            </div>
        </div>

        <div class="card">
            <h2 class="section-title">Admin Users</h2>

            <div class="table-wrap">
                <table>
                    <tr>
                        <th>ID</th>
                        <th>Username</th>
                        <th>Role</th>
                        <th>Actions</th>
                    </tr>

                    <% if (users && users.length > 0) { %>
                        <% users.forEach(adminUser => { %>
                            <tr>
                                <td><%= adminUser.id %></td>

                                <td>
                                    <span class="username-text">
                                        <%= adminUser.username || "-" %>
                                    </span>
                                </td>

                                <td>
                                    <span class="admin-role-pill">
                                        <%= adminUser.role || "-" %>
                                    </span>
                                </td>

                                <td>
                                    <div class="action-buttons">

                                        <form action="/admin-users/reset-password/<%= adminUser.id %>" method="POST">
                                            <button class="secondary-btn" type="submit">
                                                Reset Password
                                            </button>
                                        </form>

                                        <% if (adminUser.username !== "admin") { %>
                                            <form action="/admin-users/delete/<%= adminUser.id %>" method="POST">
                                                <button class="delete-btn" type="submit">
                                                    Delete
                                                </button>
                                            </form>
                                        <% } else { %>
                                            <span class="main-admin-pill">Main Admin</span>
                                        <% } %>

                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="4">No admin users found.</td>
                        </tr>
                    <% } %>
                </table>
            </div>
        </div>

    </main>

</div>

<script>
    const menuToggle = document.getElementById("menuToggle");
    const sidebar = document.getElementById("sidebar");
    const sidebarOverlay = document.getElementById("sidebarOverlay");

    function openSidebar() {
        sidebar.classList.add("open");
        sidebarOverlay.classList.add("show");
    }

    function closeSidebar() {
        sidebar.classList.remove("open");
        sidebarOverlay.classList.remove("show");
    }

    if (menuToggle) {
        menuToggle.addEventListener("click", openSidebar);
    }

    if (sidebarOverlay) {
        sidebarOverlay.addEventListener("click", closeSidebar);
    }

    document.querySelectorAll(".sidebar nav a").forEach(function (link) {
        link.addEventListener("click", closeSidebar);
    });

    if ("serviceWorker" in navigator) {
        window.addEventListener("load", function () {
            navigator.serviceWorker.register("/service-worker.js")
                .then(function () {
                    console.log("VLCG HRMS service worker registered");
                })
                .catch(function (error) {
                    console.log("Service worker registration failed:", error);
                });
        });
    }
</script>

</body>
</html>