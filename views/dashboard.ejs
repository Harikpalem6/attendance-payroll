<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#0f172a">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="VLCG HRMS">

    <title>Dashboard - VLCG HRMS</title>
    <link rel="stylesheet" href="/css/style.css">

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #f3f6fb;
            font-family: Arial, sans-serif;
            color: #111827;
        }

        .app-layout {
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            width: 250px;
            background: #0f172a;
            color: #ffffff;
            padding: 22px 18px;
            position: fixed;
            left: 0;
            top: 0;
            bottom: 0;
            overflow-y: auto;
            z-index: 1000;
        }

        .sidebar h2 {
            margin: 0 0 24px;
            font-size: 24px;
            letter-spacing: 0.5px;
        }

        .sidebar nav {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .sidebar nav a {
            color: #e5e7eb;
            text-decoration: none;
            padding: 11px 12px;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 500;
        }

        .sidebar nav a:hover,
        .sidebar nav a.active {
            background: #1e293b;
            color: #ffffff;
        }

        .content {
            margin-left: 250px;
            width: calc(100% - 250px);
            padding: 24px;
        }

        .mobile-topbar {
            display: none;
            background: #0f172a;
            color: #ffffff;
            padding: 14px 16px;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 900;
        }

        .mobile-topbar h2 {
            margin: 0;
            font-size: 18px;
        }

        .menu-toggle {
            border: none;
            background: #1e293b;
            color: #ffffff;
            padding: 9px 12px;
            border-radius: 8px;
            font-size: 18px;
            cursor: pointer;
        }

        .sidebar-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, 0.55);
            z-index: 950;
        }

        .page-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            margin-bottom: 22px;
        }

        .page-title h1 {
            margin: 0;
            font-size: 30px;
            color: #111827;
        }

        .page-title p {
            margin: 6px 0 0;
            color: #6b7280;
            font-size: 14px;
        }

        .user-badge {
            background: #ffffff;
            border-radius: 12px;
            padding: 10px 14px;
            box-shadow: 0 2px 8px rgba(15, 23, 42, 0.08);
            font-size: 14px;
            color: #374151;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(160px, 1fr));
            gap: 18px;
            margin-bottom: 26px;
        }

        .card,
        .chart-card {
            background: #ffffff;
            border-radius: 16px;
            padding: 20px;
            box-shadow: 0 4px 14px rgba(15, 23, 42, 0.08);
        }

        .stat-card {
            position: relative;
            overflow: hidden;
        }

        .stat-card h2 {
            margin: 0 0 10px;
            color: #6b7280;
            font-size: 14px;
            font-weight: 600;
        }

        .stat-card p {
            margin: 0;
            color: #111827;
            font-size: 34px;
            font-weight: 700;
        }

        .stat-card::after {
            content: "";
            position: absolute;
            right: -26px;
            top: -26px;
            width: 88px;
            height: 88px;
            border-radius: 50%;
            background: rgba(37, 99, 235, 0.10);
        }

        .section-title {
            margin: 0 0 16px;
            font-size: 22px;
            color: #111827;
        }

        .chart-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(260px, 1fr));
            gap: 20px;
            margin-bottom: 26px;
        }

        .chart-card h3 {
            margin: 0;
            font-size: 18px;
            color: #111827;
        }

        .chart-subtitle {
            margin: 6px 0 18px;
            font-size: 13px;
            color: #6b7280;
        }

        .bar-row {
            margin-bottom: 16px;
        }

        .bar-label {
            display: flex;
            justify-content: space-between;
            gap: 12px;
            font-weight: 600;
            margin-bottom: 7px;
            font-size: 14px;
            color: #374151;
        }

        .bar-bg {
            width: 100%;
            height: 13px;
            background: #e5e7eb;
            border-radius: 20px;
            overflow: hidden;
        }

        .bar-fill {
            height: 100%;
            background: #2563eb;
            border-radius: 20px;
        }

        .bar-fill.present {
            background: #16a34a;
        }

        .bar-fill.absent {
            background: #dc2626;
        }

        .bar-fill.halfday {
            background: #f59e0b;
        }

        .bar-fill.pending {
            background: #f59e0b;
        }

        .bar-fill.approved {
            background: #16a34a;
        }

        .bar-fill.rejected {
            background: #dc2626;
        }

        .notifications-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 14px;
            margin-bottom: 16px;
        }

        .notifications-header h2 {
            margin: 0;
            font-size: 20px;
        }

        .secondary-btn {
            border: none;
            border-radius: 9px;
            background: #e5e7eb;
            color: #111827;
            padding: 9px 12px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            white-space: nowrap;
        }

        .secondary-btn:hover {
            background: #d1d5db;
        }

        .table-wrap {
            width: 100%;
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 760px;
        }

        th,
        td {
            text-align: left;
            padding: 12px 10px;
            border-bottom: 1px solid #e5e7eb;
            font-size: 14px;
            vertical-align: top;
        }

        th {
            background: #f8fafc;
            color: #374151;
            font-weight: 700;
        }

        .unread-row {
            font-weight: bold;
            background: #f8fafc;
        }

        .status-badge {
            display: inline-block;
            padding: 5px 9px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 700;
        }

        .status-read {
            background: #dcfce7;
            color: #166534;
        }

        .status-unread {
            background: #fee2e2;
            color: #991b1b;
        }

        .empty-text {
            color: #6b7280;
            font-size: 14px;
        }

        @media (max-width: 1200px) {
            .stats-grid {
                grid-template-columns: repeat(2, minmax(160px, 1fr));
            }

            .chart-grid {
                grid-template-columns: repeat(2, minmax(260px, 1fr));
            }
        }

        @media (max-width: 768px) {
            .mobile-topbar {
                display: flex;
            }

            .app-layout {
                display: block;
            }

            .sidebar {
                transform: translateX(-100%);
                transition: transform 0.25s ease;
                width: 280px;
            }

            .sidebar.open {
                transform: translateX(0);
            }

            .sidebar-overlay.show {
                display: block;
            }

            .content {
                margin-left: 0;
                width: 100%;
                padding: 18px 14px 26px;
            }

            .page-header {
                flex-direction: column;
                align-items: flex-start;
                margin-bottom: 18px;
            }

            .page-title h1 {
                font-size: 26px;
            }

            .user-badge {
                width: 100%;
            }

            .stats-grid {
                grid-template-columns: repeat(2, minmax(130px, 1fr));
                gap: 12px;
            }

            .card,
            .chart-card {
                padding: 16px;
                border-radius: 14px;
            }

            .stat-card h2 {
                font-size: 13px;
            }

            .stat-card p {
                font-size: 28px;
            }

            .chart-grid {
                grid-template-columns: 1fr;
                gap: 14px;
            }

            .notifications-header {
                flex-direction: column;
                align-items: flex-start;
            }

            .notifications-header form,
            .notifications-header button {
                width: 100%;
            }

            .secondary-btn {
                width: 100%;
            }
        }

        @media (max-width: 420px) {
            .stats-grid {
                grid-template-columns: 1fr;
            }

            .page-title h1 {
                font-size: 24px;
            }
        }
    </style>
</head>
<body>

<div class="mobile-topbar">
    <button type="button" class="menu-toggle" id="menuToggle">☰</button>
    <h2>VLCG HRMS</h2>
</div>

<div class="sidebar-overlay" id="sidebarOverlay"></div>

<div class="app-layout">

    <aside class="sidebar" id="sidebar">
        <h2>HRMS</h2>

        <nav>
            <a href="/dashboard" class="active">Dashboard</a>

            <% if (user && (user.role === "Super Admin" || user.role === "HR")) { %>
                <a href="/employees">Employees</a>
            <% } %>

            <% if (user && (user.role === "Super Admin" || user.role === "HR")) { %>
                <a href="/password-reset-requests">Password Reset Requests</a>
            <% } %>

            <% if (user && (user.role === "Super Admin" || user.role === "HR" || user.role === "Manager")) { %>
                <a href="/attendance">Attendance</a>
                <a href="/attendance/monthly-report">Monthly Report</a>
                <a href="/attendance/regularizations">Regularizations</a>
                <a href="/leaves">Leaves</a>
                <a href="/leaves/balances">Leave Balances</a>
            <% } %>

            <% if (user && user.role === "Super Admin") { %>
                <a href="/payroll">Payroll</a>
                <a href="/admin-users">Admin Users</a>
                <a href="/company-settings">Company Settings</a>
                <a href="/activity-logs">Activity Logs</a>
                <a href="/export/backup">Download Backup</a>
            <% } %>

            <a href="/change-password">Change Password</a>
            <a href="/logout">Logout</a>
        </nav>
    </aside>

    <main class="content">

        <div class="page-header">
            <div class="page-title">
                <h1>Dashboard</h1>
                <p>Attendance, leave status, departments, and recent notifications.</p>
            </div>

            <div class="user-badge">
                Logged in as:
                <strong><%= user && user.username ? user.username : "User" %></strong>
                <% if (user && user.role) { %>
                    —
                    <strong><%= user.role %></strong>
                <% } %>
            </div>
        </div>

        <div class="stats-grid">

            <div class="card stat-card">
                <h2>Total Employees</h2>
                <p><%= totalEmployees || 0 %></p>
            </div>

            <div class="card stat-card">
                <h2>Present Today</h2>
                <p><%= presentToday || 0 %></p>
            </div>

            <div class="card stat-card">
                <h2>Absent Today</h2>
                <p><%= absentToday || 0 %></p>
            </div>

            <div class="card stat-card">
                <h2>Half Day Today</h2>
                <p><%= halfDayToday || 0 %></p>
            </div>

        </div>

        <h2 class="section-title">Dashboard Charts</h2>

        <div class="chart-grid">

            <div class="chart-card">
                <h3>Today Attendance</h3>
                <p class="chart-subtitle">Present, absent, and half-day records for today.</p>

                <% 
                    const attendanceTotal = Number(presentToday || 0) + Number(absentToday || 0) + Number(halfDayToday || 0);
                    const presentPercent = attendanceTotal > 0 ? (Number(presentToday || 0) / attendanceTotal) * 100 : 0;
                    const absentPercent = attendanceTotal > 0 ? (Number(absentToday || 0) / attendanceTotal) * 100 : 0;
                    const halfDayPercent = attendanceTotal > 0 ? (Number(halfDayToday || 0) / attendanceTotal) * 100 : 0;
                %>

                <div class="bar-row">
                    <div class="bar-label">
                        <span>Present</span>
                        <span><%= presentToday || 0 %></span>
                    </div>
                    <div class="bar-bg">
                        <div class="bar-fill present" style="width:<%= presentPercent %>%"></div>
                    </div>
                </div>

                <div class="bar-row">
                    <div class="bar-label">
                        <span>Absent</span>
                        <span><%= absentToday || 0 %></span>
                    </div>
                    <div class="bar-bg">
                        <div class="bar-fill absent" style="width:<%= absentPercent %>%"></div>
                    </div>
                </div>

                <div class="bar-row">
                    <div class="bar-label">
                        <span>Half Day</span>
                        <span><%= halfDayToday || 0 %></span>
                    </div>
                    <div class="bar-bg">
                        <div class="bar-fill halfday" style="width:<%= halfDayPercent %>%"></div>
                    </div>
                </div>
            </div>

            <div class="chart-card">
                <h3>Leave Status</h3>
                <p class="chart-subtitle">Current leave request summary.</p>

                <% 
                    const leaveTotal = Number(pendingLeaves || 0) + Number(approvedLeaves || 0) + Number(rejectedLeaves || 0);
                    const pendingPercent = leaveTotal > 0 ? (Number(pendingLeaves || 0) / leaveTotal) * 100 : 0;
                    const approvedPercent = leaveTotal > 0 ? (Number(approvedLeaves || 0) / leaveTotal) * 100 : 0;
                    const rejectedPercent = leaveTotal > 0 ? (Number(rejectedLeaves || 0) / leaveTotal) * 100 : 0;
                %>

                <div class="bar-row">
                    <div class="bar-label">
                        <span>Pending</span>
                        <span><%= pendingLeaves || 0 %></span>
                    </div>
                    <div class="bar-bg">
                        <div class="bar-fill pending" style="width:<%= pendingPercent %>%"></div>
                    </div>
                </div>

                <div class="bar-row">
                    <div class="bar-label">
                        <span>Approved</span>
                        <span><%= approvedLeaves || 0 %></span>
                    </div>
                    <div class="bar-bg">
                        <div class="bar-fill approved" style="width:<%= approvedPercent %>%"></div>
                    </div>
                </div>

                <div class="bar-row">
                    <div class="bar-label">
                        <span>Rejected</span>
                        <span><%= rejectedLeaves || 0 %></span>
                    </div>
                    <div class="bar-bg">
                        <div class="bar-fill rejected" style="width:<%= rejectedPercent %>%"></div>
                    </div>
                </div>
            </div>

            <div class="chart-card">
                <h3>Employees by Department</h3>
                <p class="chart-subtitle">Department-wise employee count.</p>

                <% 
                    let maxDepartmentCount = 0;

                    if (departmentSummary && departmentSummary.length > 0) {
                        departmentSummary.forEach(item => {
                            if (Number(item.count) > maxDepartmentCount) {
                                maxDepartmentCount = Number(item.count);
                            }
                        });
                    }
                %>

                <% if (departmentSummary && departmentSummary.length > 0) { %>
                    <% departmentSummary.forEach(item => { %>
                        <% const deptPercent = maxDepartmentCount > 0 ? (Number(item.count) / maxDepartmentCount) * 100 : 0; %>

                        <div class="bar-row">
                            <div class="bar-label">
                                <span><%= item.department || "Not Assigned" %></span>
                                <span><%= item.count || 0 %></span>
                            </div>
                            <div class="bar-bg">
                                <div class="bar-fill" style="width:<%= deptPercent %>%"></div>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <p class="empty-text">No department data found.</p>
                <% } %>
            </div>

        </div>

        <div class="card">
            <div class="notifications-header">
                <h2>Recent Admin Notifications</h2>

                <form action="/notifications/read-all" method="POST">
                    <button type="submit" class="secondary-btn">
                        Mark All Read
                    </button>
                </form>
            </div>

            <div class="table-wrap">
                <table>
                    <tr>
                        <th>Status</th>
                        <th>Title</th>
                        <th>Message</th>
                        <th>Date / Time</th>
                        <th>Action</th>
                    </tr>

                    <% if (notifications && notifications.length > 0) { %>
                        <% notifications.forEach(notification => { %>
                            <tr class="<%= notification.is_read ? '' : 'unread-row' %>">
                                <td>
                                    <% if (notification.is_read) { %>
                                        <span class="status-badge status-read">Read</span>
                                    <% } else { %>
                                        <span class="status-badge status-unread">Unread</span>
                                    <% } %>
                                </td>

                                <td><%= notification.title || "-" %></td>

                                <td><%= notification.message || "-" %></td>

                                <td>
                                    <%= notification.created_at ? new Date(notification.created_at).toLocaleString() : "" %>
                                </td>

                                <td>
                                    <% if (notification.is_read) { %>
                                        <form action="/notifications/unread/<%= notification.id %>" method="POST">
                                            <button type="submit" class="secondary-btn">
                                                Mark Unread
                                            </button>
                                        </form>
                                    <% } else { %>
                                        <form action="/notifications/read/<%= notification.id %>" method="POST">
                                            <button type="submit" class="secondary-btn">
                                                Mark Read
                                            </button>
                                        </form>
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="5">No notifications yet.</td>
                        </tr>
                    <% } %>
                </table>
            </div>
        </div>

    </main>

</div>

<script>
    const menuToggle = document.getElementById("menuToggle");
    const sidebar = document.getElementById("sidebar");
    const sidebarOverlay = document.getElementById("sidebarOverlay");

    function openSidebar() {
        sidebar.classList.add("open");
        sidebarOverlay.classList.add("show");
    }

    function closeSidebar() {
        sidebar.classList.remove("open");
        sidebarOverlay.classList.remove("show");
    }

    if (menuToggle) {
        menuToggle.addEventListener("click", openSidebar);
    }

    if (sidebarOverlay) {
        sidebarOverlay.addEventListener("click", closeSidebar);
    }

    document.querySelectorAll(".sidebar nav a").forEach(function (link) {
        link.addEventListener("click", closeSidebar);
    });

    if ("serviceWorker" in navigator) {
        window.addEventListener("load", function () {
            navigator.serviceWorker.register("/service-worker.js")
                .then(function () {
                    console.log("VLCG HRMS service worker registered");
                })
                .catch(function (error) {
                    console.log("Service worker registration failed:", error);
                });
        });
    }
</script>

</body>
</html>