<!DOCTYPE html>
<html>
<head>
    <title>Activity Logs</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<div class="app-layout">

    <aside class="sidebar">
        <h2>HRMS</h2>

        <nav>
            <a href="/dashboard">Dashboard</a>

            <% if (user && (user.role === "Super Admin" || user.role === "HR")) { %>
                <a href="/employees">Employees</a>
            <% } %>

            <% if (user && (user.role === "Super Admin" || user.role === "HR" || user.role === "Manager")) { %>
                <a href="/attendance">Attendance</a>
                <a href="/attendance/monthly-report">Monthly Report</a>
                <a href="/leaves">Leaves</a>
                <a href="/leaves/balances">Leave Balances</a>
            <% } %>

            <% if (user && user.role === "Super Admin") { %>
                <a href="/payroll">Payroll</a>
                <a href="/admin-users">Admin Users</a>
                <a href="/company-settings">Company Settings</a>
                <a href="/activity-logs">Activity Logs</a>
                <a href="/export/backup">Download Backup</a>
            <% } %>

            <a href="/logout">Logout</a>
        </nav>
    </aside>

    <main class="content">

        <h1>Activity Logs</h1>

        <div class="card">
            <h2>Search / Filter Logs</h2>

            <br>

            <form action="/activity-logs" method="GET" class="stack-form">

                <label>Username</label>
                <input
                    type="text"
                    name="username"
                    placeholder="Search username"
                    value="<%= filters && filters.username ? filters.username : '' %>"
                >

                <label>Role</label>
                <select name="role">
                    <option value="">All Roles</option>

                    <option value="Super Admin" <%= filters && filters.role === 'Super Admin' ? 'selected' : '' %>>
                        Super Admin
                    </option>

                    <option value="HR" <%= filters && filters.role === 'HR' ? 'selected' : '' %>>
                        HR
                    </option>

                    <option value="Manager" <%= filters && filters.role === 'Manager' ? 'selected' : '' %>>
                        Manager
                    </option>
                </select>

                <label>Action</label>
                <input
                    type="text"
                    name="action"
                    placeholder="Search action, example: Employee Updated"
                    value="<%= filters && filters.action ? filters.action : '' %>"
                >

                <label>Date</label>
                <input
                    type="date"
                    name="date"
                    value="<%= filters && filters.date ? filters.date : '' %>"
                >

                <div>
                    <button type="submit">
                        Search Logs
                    </button>

                    <a class="secondary-btn" href="/activity-logs">
                        Clear Filter
                    </a>

                    <a
                        class="secondary-btn"
                        href="/export/activity-logs?username=<%= encodeURIComponent(filters && filters.username ? filters.username : '') %>&role=<%= encodeURIComponent(filters && filters.role ? filters.role : '') %>&action=<%= encodeURIComponent(filters && filters.action ? filters.action : '') %>&date=<%= encodeURIComponent(filters && filters.date ? filters.date : '') %>"
                    >
                        Export Excel
                    </a>
                </div>

            </form>
        </div>

        <br>

        <h2>Recent Activity Logs</h2>

        <table>
            <tr>
                <th>ID</th>
                <th>User</th>
                <th>Role</th>
                <th>Action</th>
                <th>Details</th>
                <th>Date / Time</th>
            </tr>

            <% if (logs && logs.length > 0) { %>
                <% logs.forEach(log => { %>
                    <tr>
                        <td><%= log.id %></td>
                        <td><%= log.username || '-' %></td>
                        <td><%= log.role || '-' %></td>
                        <td><%= log.action || '-' %></td>
                        <td><%= log.details || '-' %></td>
                        <td><%= log.created_at ? new Date(log.created_at).toLocaleString() : '' %></td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="6">
                        No activity logs found.
                    </td>
                </tr>
            <% } %>
        </table>

    </main>

</div>

</body>
</html>