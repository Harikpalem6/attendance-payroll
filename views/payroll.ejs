<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#0f172a">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="VLCG HRMS">

    <title>Payroll Management - VLCG HRMS</title>
    <link rel="stylesheet" href="/css/style.css">

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #f3f6fb;
            font-family: Arial, sans-serif;
            color: #111827;
        }

        .app-layout {
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            width: 250px;
            background: #0f172a;
            color: #ffffff;
            padding: 22px 18px;
            position: fixed;
            left: 0;
            top: 0;
            bottom: 0;
            overflow-y: auto;
            z-index: 1000;
        }

        .sidebar h2 {
            margin: 0 0 24px;
            font-size: 24px;
        }

        .sidebar nav {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .sidebar nav a {
            color: #e5e7eb;
            text-decoration: none;
            padding: 11px 12px;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 500;
        }

        .sidebar nav a:hover,
        .sidebar nav a.active {
            background: #1e293b;
            color: #ffffff;
        }

        .content {
            margin-left: 250px;
            width: calc(100% - 250px);
            padding: 24px;
        }

        .mobile-topbar {
            display: none;
            background: #0f172a;
            color: #ffffff;
            padding: 14px 16px;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 900;
        }

        .mobile-topbar h2 {
            margin: 0;
            font-size: 18px;
        }

        .menu-toggle {
            border: none;
            background: #1e293b;
            color: #ffffff;
            padding: 9px 14px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
        }

        .sidebar-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, 0.55);
            z-index: 950;
        }

        .page-header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 16px;
            margin-bottom: 22px;
        }

        .page-header h1 {
            margin: 0;
            font-size: 30px;
        }

        .page-header p {
            margin: 7px 0 0;
            color: #6b7280;
            font-size: 14px;
        }

        .role-badge {
            background: #ffffff;
            border-radius: 12px;
            padding: 10px 14px;
            box-shadow: 0 2px 8px rgba(15, 23, 42, 0.08);
            font-size: 14px;
            color: #374151;
            white-space: nowrap;
        }

        .role-pill {
            display: inline-block;
            margin-left: 6px;
            background: #dbeafe;
            color: #1d4ed8;
            padding: 5px 9px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 700;
        }

        .card,
        .toolbar-card {
            background: #ffffff;
            border-radius: 16px;
            padding: 18px;
            box-shadow: 0 4px 14px rgba(15, 23, 42, 0.08);
            margin-bottom: 22px;
        }

        .toolbar-title {
            margin: 0 0 14px;
            font-size: 20px;
            color: #111827;
        }

        .toolbar {
            display: flex;
            gap: 12px;
            align-items: center;
            flex-wrap: wrap;
        }

        .toolbar select,
        .toolbar input {
            flex: 1;
            min-width: 220px;
            padding: 12px 13px;
            border: 1px solid #cbd5e1;
            border-radius: 10px;
            font-size: 15px;
            outline: none;
            background: #ffffff;
        }

        .toolbar select:focus,
        .toolbar input:focus,
        .payment-form select:focus,
        .payment-form input:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
        }

        .primary-btn,
        .secondary-btn,
        .save-btn,
        .email-btn,
        .payment-btn {
            border: none;
            border-radius: 10px;
            padding: 10px 13px;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            white-space: nowrap;
        }

        .primary-btn {
            background: #2563eb;
            color: #ffffff;
        }

        .primary-btn:hover {
            background: #1d4ed8;
        }

        .secondary-btn {
            background: #0f172a;
            color: #ffffff;
        }

        .secondary-btn:hover {
            background: #1e293b;
        }

        .save-btn {
            background: #16a34a;
            color: #ffffff;
        }

        .save-btn:hover {
            background: #15803d;
        }

        .email-btn {
            background: #f59e0b;
            color: #ffffff;
        }

        .email-btn:hover {
            background: #d97706;
        }

        .payment-btn {
            background: #2563eb;
            color: #ffffff;
            width: 100%;
        }

        .payment-btn:hover {
            background: #1d4ed8;
        }

        .result-header {
            display: flex;
            justify-content: space-between;
            gap: 14px;
            flex-wrap: wrap;
            margin-bottom: 18px;
        }

        .result-header h2 {
            margin: 0;
            font-size: 22px;
        }

        .employee-pill {
            display: inline-block;
            background: #dbeafe;
            color: #1d4ed8;
            padding: 7px 11px;
            border-radius: 999px;
            font-size: 13px;
            font-weight: 700;
        }

        .payroll-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(160px, 1fr));
            gap: 14px;
            margin-bottom: 18px;
        }

        .payroll-item {
            background: #f8fafc;
            border: 1px solid #e5e7eb;
            border-radius: 14px;
            padding: 15px;
        }

        .payroll-item span {
            display: block;
            color: #6b7280;
            font-size: 13px;
            margin-bottom: 7px;
        }

        .payroll-item strong {
            display: block;
            color: #111827;
            font-size: 19px;
        }

        .net-salary {
            background: #dcfce7;
            border-color: #bbf7d0;
        }

        .net-salary strong {
            color: #166534;
        }

        .deduction-item {
            background: #fee2e2;
            border-color: #fecaca;
        }

        .deduction-item strong {
            color: #991b1b;
        }

        .sub-section-title {
            margin: 22px 0 12px;
            font-size: 18px;
            color: #111827;
        }

        .button-row {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 18px;
        }

        .button-row form {
            margin: 0;
        }

        .section-title {
            margin: 0 0 14px;
            font-size: 22px;
            color: #111827;
        }

        .payment-help {
            background: #eff6ff;
            color: #1e40af;
            border: 1px solid #bfdbfe;
            padding: 13px 14px;
            border-radius: 12px;
            font-size: 14px;
            margin-bottom: 16px;
        }

        .table-wrap {
            width: 100%;
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 1650px;
            background: #ffffff;
        }

        th,
        td {
            text-align: left;
            padding: 12px 10px;
            border-bottom: 1px solid #e5e7eb;
            font-size: 14px;
            vertical-align: top;
        }

        th {
            background: #f8fafc;
            color: #374151;
            font-weight: 700;
        }

        .amount-strong {
            font-weight: 700;
            color: #166534;
        }

        .status-badge {
            display: inline-block;
            padding: 6px 10px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 700;
            white-space: nowrap;
        }

        .status-paid {
            background: #dcfce7;
            color: #166534;
        }

        .status-pending {
            background: #fef3c7;
            color: #92400e;
        }

        .payment-details {
            min-width: 210px;
            color: #374151;
            line-height: 1.5;
        }

        .payment-details strong {
            color: #111827;
        }

        .payment-form {
            min-width: 320px;
            display: grid;
            grid-template-columns: repeat(2, minmax(130px, 1fr));
            gap: 8px;
        }

        .payment-form select,
        .payment-form input {
            width: 100%;
            padding: 9px 10px;
            border: 1px solid #cbd5e1;
            border-radius: 9px;
            font-size: 13px;
            outline: none;
            background: #ffffff;
        }

        .payment-form .full-width {
            grid-column: 1 / -1;
        }

        .small-muted {
            color: #6b7280;
            font-size: 12px;
            margin-top: 4px;
        }

        @media (max-width: 1200px) {
            .payroll-grid {
                grid-template-columns: repeat(2, minmax(160px, 1fr));
            }
        }

        @media (max-width: 768px) {
            .mobile-topbar {
                display: flex;
            }

            .app-layout {
                display: block;
            }

            .sidebar {
                transform: translateX(-100%);
                transition: transform 0.25s ease;
                width: 280px;
            }

            .sidebar.open {
                transform: translateX(0);
            }

            .sidebar-overlay.show {
                display: block;
            }

            .content {
                margin-left: 0;
                width: 100%;
                padding: 18px 14px 26px;
            }

            .page-header {
                flex-direction: column;
                align-items: flex-start;
            }

            .page-header h1 {
                font-size: 26px;
            }

            .role-badge {
                width: 100%;
                white-space: normal;
            }

            .card,
            .toolbar-card {
                padding: 16px;
                border-radius: 14px;
            }

            .toolbar {
                flex-direction: column;
                align-items: stretch;
            }

            .toolbar select,
            .toolbar input,
            .toolbar button {
                width: 100%;
                min-width: 0;
            }

            .payroll-grid {
                grid-template-columns: 1fr;
            }

            .button-row {
                flex-direction: column;
            }

            .button-row form,
            .button-row button {
                width: 100%;
            }
        }
    </style>
</head>
<body>

<div class="mobile-topbar">
    <button type="button" class="menu-toggle" id="menuToggle">
        Menu
    </button>

    <h2>VLCG HRMS</h2>
</div>

<div class="sidebar-overlay" id="sidebarOverlay"></div>

<div class="app-layout">

    <aside class="sidebar" id="sidebar">
        <h2>HRMS</h2>

        <nav>
            <a href="/dashboard">Dashboard</a>

            <% if (user && (user.role === "Super Admin" || user.role === "HR")) { %>
                <a href="/employees">Employees</a>
            <% } %>

            <% if (user && (user.role === "Super Admin" || user.role === "HR")) { %>
                <a href="/password-reset-requests">Password Reset Requests</a>
            <% } %>

            <% if (user && (user.role === "Super Admin" || user.role === "HR" || user.role === "Manager")) { %>
                <a href="/attendance">Attendance</a>
                <a href="/attendance/monthly-report">Monthly Report</a>
                <a href="/attendance/regularizations">Regularizations</a>
                <a href="/leaves">Leaves</a>
                <a href="/leaves/balances">Leave Balances</a>
            <% } %>

            <% if (user && user.role === "Super Admin") { %>
                <a href="/payroll" class="active">Payroll</a>
                <a href="/admin-users">Admin Users</a>
                <a href="/company-settings">Company Settings</a>
                <a href="/activity-logs">Activity Logs</a>
                <a href="/export/backup">Download Backup</a>
            <% } %>

            <a href="/change-password">Change Password</a>
            <a href="/logout">Logout</a>
        </nav>
    </aside>

    <main class="content">

        <div class="page-header">
            <div>
                <h1>Payroll Management</h1>
                <p>Calculate payroll, save records, download payslips, email payslips, and track salary payments.</p>
            </div>

            <div class="role-badge">
                Logged in as
                <strong><%= user && user.username ? user.username : "User" %></strong>

                <% if (user && user.role) { %>
                    <span class="role-pill"><%= user.role %></span>
                <% } %>
            </div>
        </div>

        <div class="toolbar-card">
            <h2 class="toolbar-title">Calculate Payroll</h2>

            <form action="/payroll/calculate" method="POST" class="toolbar">

                <select name="employee_id" required>
                    <option value="">Select Employee</option>

                    <% employees.forEach(emp => { %>
                        <option value="<%= emp.id %>">
                            <%= emp.name %>
                        </option>
                    <% }) %>
                </select>

                <input type="month" name="month" required>

                <button type="submit" class="primary-btn">
                    Calculate Payroll
                </button>

            </form>
        </div>

        <% if (payroll) { %>

            <% 
                const basicSalary = Number(payroll.basicSalary || 0);
                const hra = Number(payroll.hra || 0);
                const allowances = Number(payroll.allowances || 0);
                const bonus = Number(payroll.bonus || 0);
                const grossSalary = Number(payroll.grossSalary || payroll.employee.salary || 0);

                const attendanceDeduction = Number(payroll.attendanceDeduction || 0);
                const pfDeduction = Number(payroll.pfDeduction || 0);
                const esiDeduction = Number(payroll.esiDeduction || 0);
                const professionalTax = Number(payroll.professionalTax || 0);
                const otherDeduction = Number(payroll.otherDeduction || 0);
                const totalDeduction = Number(payroll.deduction || 0);
                const finalSalary = Number(payroll.finalSalary || 0);
            %>

            <div class="card">

                <div class="result-header">
                    <div>
                        <h2>Payroll Result</h2>
                        <p style="margin: 7px 0 0; color: #6b7280;">
                            <strong>Month:</strong> <%= payroll.month %>
                        </p>
                    </div>

                    <span class="employee-pill">
                        <%= payroll.employee.name %>
                        <% if (payroll.employee.department) { %>
                            - <%= payroll.employee.department %>
                        <% } %>
                    </span>
                </div>

                <h3 class="sub-section-title">Earnings</h3>

                <div class="payroll-grid">
                    <div class="payroll-item">
                        <span>Basic Salary</span>
                        <strong>Rs. <%= basicSalary.toFixed(2) %></strong>
                    </div>

                    <div class="payroll-item">
                        <span>HRA</span>
                        <strong>Rs. <%= hra.toFixed(2) %></strong>
                    </div>

                    <div class="payroll-item">
                        <span>Allowances</span>
                        <strong>Rs. <%= allowances.toFixed(2) %></strong>
                    </div>

                    <div class="payroll-item">
                        <span>Bonus</span>
                        <strong>Rs. <%= bonus.toFixed(2) %></strong>
                    </div>

                    <div class="payroll-item">
                        <span>Gross Salary</span>
                        <strong>Rs. <%= grossSalary.toFixed(2) %></strong>
                    </div>
                </div>

                <h3 class="sub-section-title">Attendance</h3>

                <div class="payroll-grid">
                    <div class="payroll-item">
                        <span>Present Days</span>
                        <strong><%= payroll.present || 0 %></strong>
                    </div>

                    <div class="payroll-item">
                        <span>Absent Days</span>
                        <strong><%= payroll.absent || 0 %></strong>
                    </div>

                    <div class="payroll-item">
                        <span>Half Days</span>
                        <strong><%= payroll.halfday || 0 %></strong>
                    </div>

                    <div class="payroll-item deduction-item">
                        <span>Attendance Deduction</span>
                        <strong>Rs. <%= attendanceDeduction.toFixed(2) %></strong>
                    </div>
                </div>

                <h3 class="sub-section-title">Deductions</h3>

                <div class="payroll-grid">
                    <div class="payroll-item deduction-item">
                        <span>PF Deduction</span>
                        <strong>Rs. <%= pfDeduction.toFixed(2) %></strong>
                    </div>

                    <div class="payroll-item deduction-item">
                        <span>ESI Deduction</span>
                        <strong>Rs. <%= esiDeduction.toFixed(2) %></strong>
                    </div>

                    <div class="payroll-item deduction-item">
                        <span>Professional Tax</span>
                        <strong>Rs. <%= professionalTax.toFixed(2) %></strong>
                    </div>

                    <div class="payroll-item deduction-item">
                        <span>Other Deduction</span>
                        <strong>Rs. <%= otherDeduction.toFixed(2) %></strong>
                    </div>

                    <div class="payroll-item deduction-item">
                        <span>Total Deductions</span>
                        <strong>Rs. <%= totalDeduction.toFixed(2) %></strong>
                    </div>

                    <div class="payroll-item net-salary">
                        <span>Final Salary</span>
                        <strong>Rs. <%= finalSalary.toFixed(2) %></strong>
                    </div>
                </div>

                <div class="button-row">

                    <form action="/payroll/save" method="POST">

                        <input type="hidden" name="employee_id" value="<%= payroll.employee.id %>">
                        <input type="hidden" name="month" value="<%= payroll.month %>">

                        <input type="hidden" name="base_salary" value="<%= grossSalary.toFixed(2) %>">
                        <input type="hidden" name="basic_salary" value="<%= basicSalary.toFixed(2) %>">
                        <input type="hidden" name="hra" value="<%= hra.toFixed(2) %>">
                        <input type="hidden" name="allowances" value="<%= allowances.toFixed(2) %>">
                        <input type="hidden" name="bonus" value="<%= bonus.toFixed(2) %>">

                        <input type="hidden" name="pf_deduction" value="<%= pfDeduction.toFixed(2) %>">
                        <input type="hidden" name="esi_deduction" value="<%= esiDeduction.toFixed(2) %>">
                        <input type="hidden" name="professional_tax" value="<%= professionalTax.toFixed(2) %>">
                        <input type="hidden" name="other_deduction" value="<%= otherDeduction.toFixed(2) %>">

                        <input type="hidden" name="present_days" value="<%= payroll.present || 0 %>">
                        <input type="hidden" name="absent_days" value="<%= payroll.absent || 0 %>">
                        <input type="hidden" name="half_days" value="<%= payroll.halfday || 0 %>">
                        <input type="hidden" name="deduction" value="<%= totalDeduction.toFixed(2) %>">
                        <input type="hidden" name="final_salary" value="<%= finalSalary.toFixed(2) %>">

                        <button type="submit" class="save-btn">
                            Save Payroll Record
                        </button>

                    </form>

                    <form action="/payroll/payslip" method="POST">

                        <input type="hidden" name="employeeName" value="<%= payroll.employee.name %>">
                        <input type="hidden" name="department" value="<%= payroll.employee.department || '' %>">
                        <input type="hidden" name="email" value="<%= payroll.employee.email || '' %>">
                        <input type="hidden" name="photo_path" value="<%= payroll.employee.photo_path || '' %>">

                        <input type="hidden" name="bank_name" value="<%= payroll.employee.bank_name || '' %>">
                        <input type="hidden" name="account_holder_name" value="<%= payroll.employee.account_holder_name || '' %>">
                        <input type="hidden" name="account_number" value="<%= payroll.employee.account_number || '' %>">
                        <input type="hidden" name="ifsc_code" value="<%= payroll.employee.ifsc_code || '' %>">
                        <input type="hidden" name="upi_id" value="<%= payroll.employee.upi_id || '' %>">
                        <input type="hidden" name="pan_number" value="<%= payroll.employee.pan_number || '' %>">

                        <input type="hidden" name="salary" value="<%= grossSalary.toFixed(2) %>">
                        <input type="hidden" name="basicSalary" value="<%= basicSalary.toFixed(2) %>">
                        <input type="hidden" name="hra" value="<%= hra.toFixed(2) %>">
                        <input type="hidden" name="allowances" value="<%= allowances.toFixed(2) %>">
                        <input type="hidden" name="bonus" value="<%= bonus.toFixed(2) %>">

                        <input type="hidden" name="grossSalary" value="<%= grossSalary.toFixed(2) %>">
                        <input type="hidden" name="attendanceDeduction" value="<%= attendanceDeduction.toFixed(2) %>">
                        <input type="hidden" name="pfDeduction" value="<%= pfDeduction.toFixed(2) %>">
                        <input type="hidden" name="esiDeduction" value="<%= esiDeduction.toFixed(2) %>">
                        <input type="hidden" name="professionalTax" value="<%= professionalTax.toFixed(2) %>">
                        <input type="hidden" name="otherDeduction" value="<%= otherDeduction.toFixed(2) %>">

                        <input type="hidden" name="present" value="<%= payroll.present || 0 %>">
                        <input type="hidden" name="absent" value="<%= payroll.absent || 0 %>">
                        <input type="hidden" name="halfday" value="<%= payroll.halfday || 0 %>">
                        <input type="hidden" name="deduction" value="<%= totalDeduction.toFixed(2) %>">
                        <input type="hidden" name="finalSalary" value="<%= finalSalary.toFixed(2) %>">
                        <input type="hidden" name="month" value="<%= payroll.month %>">

                        <button type="submit" class="secondary-btn">
                            Download PDF Payslip
                        </button>

                    </form>

                    <form action="/payroll/email-payslip" method="POST">

                        <input type="hidden" name="employeeName" value="<%= payroll.employee.name %>">
                        <input type="hidden" name="department" value="<%= payroll.employee.department || '' %>">
                        <input type="hidden" name="email" value="<%= payroll.employee.email || '' %>">
                        <input type="hidden" name="photo_path" value="<%= payroll.employee.photo_path || '' %>">

                        <input type="hidden" name="bank_name" value="<%= payroll.employee.bank_name || '' %>">
                        <input type="hidden" name="account_holder_name" value="<%= payroll.employee.account_holder_name || '' %>">
                        <input type="hidden" name="account_number" value="<%= payroll.employee.account_number || '' %>">
                        <input type="hidden" name="ifsc_code" value="<%= payroll.employee.ifsc_code || '' %>">
                        <input type="hidden" name="upi_id" value="<%= payroll.employee.upi_id || '' %>">
                        <input type="hidden" name="pan_number" value="<%= payroll.employee.pan_number || '' %>">

                        <input type="hidden" name="salary" value="<%= grossSalary.toFixed(2) %>">
                        <input type="hidden" name="basicSalary" value="<%= basicSalary.toFixed(2) %>">
                        <input type="hidden" name="hra" value="<%= hra.toFixed(2) %>">
                        <input type="hidden" name="allowances" value="<%= allowances.toFixed(2) %>">
                        <input type="hidden" name="bonus" value="<%= bonus.toFixed(2) %>">

                        <input type="hidden" name="grossSalary" value="<%= grossSalary.toFixed(2) %>">
                        <input type="hidden" name="attendanceDeduction" value="<%= attendanceDeduction.toFixed(2) %>">
                        <input type="hidden" name="pfDeduction" value="<%= pfDeduction.toFixed(2) %>">
                        <input type="hidden" name="esiDeduction" value="<%= esiDeduction.toFixed(2) %>">
                        <input type="hidden" name="professionalTax" value="<%= professionalTax.toFixed(2) %>">
                        <input type="hidden" name="otherDeduction" value="<%= otherDeduction.toFixed(2) %>">

                        <input type="hidden" name="present" value="<%= payroll.present || 0 %>">
                        <input type="hidden" name="absent" value="<%= payroll.absent || 0 %>">
                        <input type="hidden" name="halfday" value="<%= payroll.halfday || 0 %>">
                        <input type="hidden" name="deduction" value="<%= totalDeduction.toFixed(2) %>">
                        <input type="hidden" name="finalSalary" value="<%= finalSalary.toFixed(2) %>">
                        <input type="hidden" name="month" value="<%= payroll.month %>">

                        <button type="submit" class="email-btn">
                            Email Payslip
                        </button>

                    </form>

                </div>

            </div>

        <% } %>

        <div class="card">
            <h2 class="section-title">Payroll History</h2>

            <div class="payment-help">
                Use this section to track whether salary is <strong>Pending</strong> or <strong>Paid</strong>. Add payment date, mode, UTR/reference number, and remarks after salary transfer.
            </div>

            <div class="table-wrap">
                <table>
                    <tr>
                        <th>ID</th>
                        <th>Employee</th>
                        <th>Month</th>
                        <th>Gross Salary</th>
                        <th>Present</th>
                        <th>Absent</th>
                        <th>Half Days</th>
                        <th>Deduction</th>
                        <th>Net Salary</th>
                        <th>Payment Status</th>
                        <th>Payment Details</th>
                        <th>Update Payment</th>
                        <th>Created</th>
                        <th>PDF</th>
                    </tr>

                    <% if (history && history.length > 0) { %>
                        <% history.forEach(record => { %>

                            <%
                                const paymentStatus = record.payment_status || "Pending";
                                const paymentDateValue = record.payment_date
                                    ? new Date(record.payment_date).toISOString().split("T")[0]
                                    : "";
                            %>

                            <tr>
                                <td><%= record.id %></td>
                                <td><%= record.name || "-" %></td>
                                <td><%= record.month || "-" %></td>
                                <td>Rs. <%= Number(record.base_salary || 0).toFixed(2) %></td>
                                <td><%= record.present_days || 0 %></td>
                                <td><%= record.absent_days || 0 %></td>
                                <td><%= record.half_days || 0 %></td>
                                <td>Rs. <%= Number(record.deduction || 0).toFixed(2) %></td>
                                <td class="amount-strong">
                                    Rs. <%= Number(record.final_salary || 0).toFixed(2) %>
                                </td>

                                <td>
                                    <% if (paymentStatus === "Paid") { %>
                                        <span class="status-badge status-paid">Paid</span>
                                    <% } else { %>
                                        <span class="status-badge status-pending">Pending</span>
                                    <% } %>

                                    <% if (record.paid_by) { %>
                                        <div class="small-muted">
                                            By: <%= record.paid_by %>
                                        </div>
                                    <% } %>
                                </td>

                                <td>
                                    <div class="payment-details">
                                        <strong>Date:</strong>
                                        <%= record.payment_date ? new Date(record.payment_date).toLocaleDateString() : "-" %>
                                        <br>

                                        <strong>Mode:</strong>
                                        <%= record.payment_mode || "-" %>
                                        <br>

                                        <strong>Ref/UTR:</strong>
                                        <%= record.payment_reference || "-" %>
                                        <br>

                                        <strong>Remarks:</strong>
                                        <%= record.payment_remarks || "-" %>
                                    </div>
                                </td>

                                <td>
                                    <form action="/payroll/payment/update/<%= record.id %>" method="POST" class="payment-form">

                                        <select name="payment_status" required>
                                            <option value="Pending" <%= paymentStatus === "Pending" ? "selected" : "" %>>
                                                Pending
                                            </option>
                                            <option value="Paid" <%= paymentStatus === "Paid" ? "selected" : "" %>>
                                                Paid
                                            </option>
                                        </select>

                                        <input
                                            type="date"
                                            name="payment_date"
                                            value="<%= paymentDateValue %>"
                                        >

                                        <select name="payment_mode">
                                            <option value="" <%= !record.payment_mode ? "selected" : "" %>>
                                                Payment Mode
                                            </option>
                                            <option value="Cash" <%= record.payment_mode === "Cash" ? "selected" : "" %>>
                                                Cash
                                            </option>
                                            <option value="Bank Transfer" <%= record.payment_mode === "Bank Transfer" ? "selected" : "" %>>
                                                Bank Transfer
                                            </option>
                                            <option value="UPI" <%= record.payment_mode === "UPI" ? "selected" : "" %>>
                                                UPI
                                            </option>
                                            <option value="Cheque" <%= record.payment_mode === "Cheque" ? "selected" : "" %>>
                                                Cheque
                                            </option>
                                            <option value="Other" <%= record.payment_mode === "Other" ? "selected" : "" %>>
                                                Other
                                            </option>
                                        </select>

                                        <input
                                            type="text"
                                            name="payment_reference"
                                            placeholder="UTR / Ref No."
                                            value="<%= record.payment_reference || '' %>"
                                        >

                                        <input
                                            type="text"
                                            name="payment_remarks"
                                            placeholder="Remarks"
                                            value="<%= record.payment_remarks || '' %>"
                                            class="full-width"
                                        >

                                        <button type="submit" class="payment-btn full-width">
                                            Update Payment
                                        </button>

                                    </form>
                                </td>

                                <td>
                                    <%= record.created_at ? new Date(record.created_at).toLocaleString() : "" %>
                                </td>

                                <td>
                                    <form action="/payroll/payslip" method="POST">

                                        <input type="hidden" name="employeeName" value="<%= record.name %>">
                                        <input type="hidden" name="department" value="">
                                        <input type="hidden" name="salary" value="<%= Number(record.base_salary || 0).toFixed(2) %>">

                                        <input type="hidden" name="basicSalary" value="<%= Number(record.basic_salary || 0).toFixed(2) %>">
                                        <input type="hidden" name="hra" value="<%= Number(record.hra || 0).toFixed(2) %>">
                                        <input type="hidden" name="allowances" value="<%= Number(record.allowances || 0).toFixed(2) %>">
                                        <input type="hidden" name="bonus" value="<%= Number(record.bonus || 0).toFixed(2) %>">

                                        <input type="hidden" name="grossSalary" value="<%= Number(record.base_salary || 0).toFixed(2) %>">
                                        <input type="hidden" name="attendanceDeduction" value="0">
                                        <input type="hidden" name="pfDeduction" value="<%= Number(record.pf_deduction || 0).toFixed(2) %>">
                                        <input type="hidden" name="esiDeduction" value="<%= Number(record.esi_deduction || 0).toFixed(2) %>">
                                        <input type="hidden" name="professionalTax" value="<%= Number(record.professional_tax || 0).toFixed(2) %>">
                                        <input type="hidden" name="otherDeduction" value="<%= Number(record.other_deduction || 0).toFixed(2) %>">

                                        <input type="hidden" name="present" value="<%= record.present_days || 0 %>">
                                        <input type="hidden" name="absent" value="<%= record.absent_days || 0 %>">
                                        <input type="hidden" name="halfday" value="<%= record.half_days || 0 %>">
                                        <input type="hidden" name="deduction" value="<%= Number(record.deduction || 0).toFixed(2) %>">
                                        <input type="hidden" name="finalSalary" value="<%= Number(record.final_salary || 0).toFixed(2) %>">
                                        <input type="hidden" name="month" value="<%= record.month %>">

                                        <button type="submit" class="secondary-btn">
                                            PDF
                                        </button>

                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="14">No payroll records saved yet.</td>
                        </tr>
                    <% } %>
                </table>
            </div>
        </div>

    </main>

</div>

<script>
    const menuToggle = document.getElementById("menuToggle");
    const sidebar = document.getElementById("sidebar");
    const sidebarOverlay = document.getElementById("sidebarOverlay");

    function openSidebar() {
        sidebar.classList.add("open");
        sidebarOverlay.classList.add("show");
    }

    function closeSidebar() {
        sidebar.classList.remove("open");
        sidebarOverlay.classList.remove("show");
    }

    if (menuToggle) {
        menuToggle.addEventListener("click", openSidebar);
    }

    if (sidebarOverlay) {
        sidebarOverlay.addEventListener("click", closeSidebar);
    }

    document.querySelectorAll(".sidebar nav a").forEach(function (link) {
        link.addEventListener("click", closeSidebar);
    });

    if ("serviceWorker" in navigator) {
        window.addEventListener("load", function () {
            navigator.serviceWorker.register("/service-worker.js")
                .then(function () {
                    console.log("VLCG HRMS service worker registered");
                })
                .catch(function (error) {
                    console.log("Service worker registration failed:", error);
                });
        });
    }
</script>

</body>
</html>