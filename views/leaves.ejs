<!DOCTYPE html>
<html>
<head>
    <title>Leave Management</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<div class="app-layout">

    <aside class="sidebar">
        <h2>HRMS</h2>

        <nav>
            <a href="/dashboard">Dashboard</a>

            <% if (user && (user.role === "Super Admin" || user.role === "HR")) { %>
                <a href="/employees">Employees</a>
            <% } %>

            <% if (user && (user.role === "Super Admin" || user.role === "HR" || user.role === "Manager")) { %>
                <a href="/attendance">Attendance</a>
                <a href="/leaves">Leaves</a>
            <% } %>

            <% if (user && user.role === "Super Admin") { %>
                <a href="/payroll">Payroll</a>
                <a href="/admin-users">Admin Users</a>
            <% } %>

            <a href="/logout">Logout</a>
        </nav>
    </aside>

    <main class="content">

        <h1>Leave Management</h1>

        <form action="/leaves/add" method="POST" class="toolbar">

            <select name="employee_id" required>
                <option value="">Select Employee</option>

                <% employees.forEach(emp => { %>
                    <option value="<%= emp.id %>">
                        <%= emp.name %>
                    </option>
                <% }) %>
            </select>

            <select name="leave_type" required>
                <option value="Sick Leave">Sick Leave</option>
                <option value="Casual Leave">Casual Leave</option>
                <option value="Paid Leave">Paid Leave</option>
            </select>

            <input type="date" name="start_date" required>
            <input type="date" name="end_date" required>

            <input
                type="text"
                name="reason"
                placeholder="Reason"
                required
            >

            <button type="submit">Apply Leave</button>

            <a class="secondary-btn" href="/export/leaves">
                Export Excel
            </a>

        </form>

        <table>
            <tr>
                <th>ID</th>
                <th>Employee</th>
                <th>Type</th>
                <th>Start Date</th>
                <th>End Date</th>
                <th>Reason</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>

            <% leaves.forEach(leave => { %>
            <tr>
                <td><%= leave.id %></td>
                <td><%= leave.name %></td>
                <td><%= leave.leave_type %></td>
                <td><%= leave.start_date %></td>
                <td><%= leave.end_date %></td>
                <td><%= leave.reason %></td>
                <td><%= leave.status %></td>

                <td class="action-buttons">

                    <% if (leave.status === "Pending") { %>

                    <form action="/leaves/approve/<%= leave.id %>" method="POST">
                        <button class="edit-btn" type="submit">
                            Approve
                        </button>
                    </form>

                    <form action="/leaves/reject/<%= leave.id %>" method="POST">
                        <button class="delete-btn" type="submit">
                            Reject
                        </button>
                    </form>

                    <% } %>

                </td>
            </tr>
            <% }) %>

        </table>

    </main>

</div>

</body>
</html>