<!DOCTYPE html>
<html>
<head>
    <title>Employee Dashboard</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<div class="app-layout">

    <aside class="sidebar">
        <h2>Employee Portal</h2>

        <nav>
    <a href="/employee/dashboard">Dashboard</a>
    <a href="/employee/leaves">Leaves</a>
    <a href="/employee/payroll">Payroll</a>
    <a href="/employee/regularizations">Regularization</a>
    <a href="/employee/change-password">Change Password</a>
    <a href="/employee/logout">Logout</a>
</nav>
    </aside>

    <main class="content">

        <div class="card" style="display:flex; align-items:center; gap:20px;">
            <img
                src="<%= photoUrl %>"
                style="width:90px; height:90px; border-radius:50%; object-fit:cover; border:2px solid #ddd;"
            >

            <div>
                <h1>Welcome, <%= employee.name %></h1>
                <p><strong>Department:</strong> <%= employee.department || '-' %></p>
                <p><strong>Designation:</strong> <%= employee.designation || '-' %></p>
            </div>
        </div>

        <br>

        <div class="card">
            <div style="display:flex; justify-content:space-between; align-items:center;">
                <h2>Your Notifications</h2>

                <form action="/employee/notifications/read-all" method="POST">
                    <button type="submit" class="secondary-btn">
                        Mark All Read
                    </button>
                </form>
            </div>

            <br>

            <table>
                <tr>
                    <th>Status</th>
                    <th>Title</th>
                    <th>Message</th>
                    <th>Date / Time</th>
                    <th>Action</th>
                </tr>

                <% if (notifications && notifications.length > 0) { %>
                    <% notifications.forEach(notification => { %>
                        <tr style="<%= notification.is_read ? '' : 'font-weight:bold; background:#f7f7f7;' %>">
                            <td>
                                <%= notification.is_read ? 'Read' : 'Unread' %>
                            </td>

                            <td><%= notification.title || '-' %></td>

                            <td><%= notification.message || '-' %></td>

                            <td>
                                <%= notification.created_at ? new Date(notification.created_at).toLocaleString() : '' %>
                            </td>

                            <td>
                                <% if (notification.is_read) { %>
                                    <form action="/employee/notifications/unread/<%= notification.id %>" method="POST">
                                        <button type="submit" class="secondary-btn">
                                            Mark Unread
                                        </button>
                                    </form>
                                <% } else { %>
                                    <form action="/employee/notifications/read/<%= notification.id %>" method="POST">
                                        <button type="submit" class="secondary-btn">
                                            Mark Read
                                        </button>
                                    </form>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="5">No notifications yet.</td>
                    </tr>
                <% } %>
            </table>
        </div>

        <br>

        <div class="card">
            <h2>Quick Actions</h2>

            <br>

            <a class="secondary-btn" href="/employee/leaves">
                Apply / View Leaves
            </a>

            <a class="secondary-btn" href="/employee/payroll">
                View Payroll
            </a>
        </div>

        <br>

        <h2>Your Attendance</h2>

        <div class="card">
            <form action="/employee/check-in" method="POST" style="display:inline-block; margin-right:10px;">
                <button type="submit">Check In</button>
            </form>

            <form action="/employee/check-out" method="POST" style="display:inline-block;">
                <button type="submit">Check Out</button>
            </form>
        </div>

        <br>

        <table>
            <tr>
                <th>Date</th>
                <th>Status</th>
                <th>Check In</th>
                <th>Check Out</th>
            </tr>

            <% if (attendance && attendance.length > 0) { %>
                <% attendance.forEach(record => { %>
                    <tr>
                        <td><%= record.date ? new Date(record.date).toLocaleDateString() : '' %></td>
                        <td><%= record.status || '-' %></td>
                        <td><%= record.check_in ? new Date(record.check_in).toLocaleTimeString() : '-' %></td>
                        <td><%= record.check_out ? new Date(record.check_out).toLocaleTimeString() : '-' %></td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="4">No attendance records found.</td>
                </tr>
            <% } %>
        </table>

        <br>

        <h2>Your Leave Requests</h2>

        <table>
            <tr>
                <th>Leave Type</th>
                <th>Start Date</th>
                <th>End Date</th>
                <th>Reason</th>
                <th>Status</th>
            </tr>

            <% if (leaves && leaves.length > 0) { %>
                <% leaves.forEach(leave => { %>
                    <tr>
                        <td><%= leave.leave_type || '-' %></td>
                        <td><%= leave.start_date ? new Date(leave.start_date).toLocaleDateString() : '' %></td>
                        <td><%= leave.end_date ? new Date(leave.end_date).toLocaleDateString() : '' %></td>
                        <td><%= leave.reason || '-' %></td>
                        <td><%= leave.status || '-' %></td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="5">No leave records found.</td>
                </tr>
            <% } %>
        </table>

    </main>

</div>

</body>
</html>