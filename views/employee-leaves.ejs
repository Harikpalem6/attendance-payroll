<!DOCTYPE html>
<html>
<head>
    <title>Employee Leaves</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<div class="app-layout">

    <aside class="sidebar">
        <h2>Employee Portal</h2>

        <nav>
    <a href="/employee/dashboard">Dashboard</a>
    <a href="/employee/leaves">Leaves</a>
    <a href="/employee/payroll">Payroll</a>
    <a href="/employee/regularizations">Regularization</a>
    <a href="/employee/change-password">Change Password</a>
    <a href="/employee/logout">Logout</a>
</nav>
    </aside>

    <main class="content">

        <h1>Your Leaves</h1>

        <div class="card">
            <h2>Leave Balance - <%= leaveBalance.year %></h2>

            <br>

            <table>
                <tr>
                    <th>Leave Type</th>
                    <th>Total</th>
                    <th>Used</th>
                    <th>Remaining</th>
                </tr>

                <tr>
                    <td>Sick Leave</td>
                    <td><%= leaveBalance.sickTotal %></td>
                    <td><%= leaveBalance.sickUsed %></td>
                    <td><%= leaveBalance.sickRemaining %></td>
                </tr>

                <tr>
                    <td>Casual Leave</td>
                    <td><%= leaveBalance.casualTotal %></td>
                    <td><%= leaveBalance.casualUsed %></td>
                    <td><%= leaveBalance.casualRemaining %></td>
                </tr>

                <tr>
                    <td>Paid Leave</td>
                    <td><%= leaveBalance.paidTotal %></td>
                    <td><%= leaveBalance.paidUsed %></td>
                    <td><%= leaveBalance.paidRemaining %></td>
                </tr>
            </table>
        </div>

        <br>

        <div class="card">
            <h2>Apply Leave</h2>

            <br>

            <form action="/employee/leaves/apply" method="POST" class="stack-form">

                <select name="leave_type" required>
                    <option value="Sick Leave">Sick Leave</option>
                    <option value="Casual Leave">Casual Leave</option>
                    <option value="Paid Leave">Paid Leave</option>
                </select>

                <input type="date" name="start_date" required>

                <input type="date" name="end_date" required>

                <input
                    type="text"
                    name="reason"
                    placeholder="Reason"
                    required
                >

                <button type="submit">Apply Leave</button>

            </form>
        </div>

        <br>

        <h2>Your Leave History</h2>

        <table>
            <tr>
                <th>ID</th>
                <th>Leave Type</th>
                <th>Start Date</th>
                <th>End Date</th>
                <th>Reason</th>
                <th>Status</th>
            </tr>

            <% if (leaves && leaves.length > 0) { %>
                <% leaves.forEach(leave => { %>
                    <tr>
                        <td><%= leave.id %></td>
                        <td><%= leave.leave_type %></td>
                        <td><%= leave.start_date ? new Date(leave.start_date).toLocaleDateString() : '' %></td>
                        <td><%= leave.end_date ? new Date(leave.end_date).toLocaleDateString() : '' %></td>
                        <td><%= leave.reason %></td>
                        <td><%= leave.status %></td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="6">No leave records found.</td>
                </tr>
            <% } %>
        </table>

    </main>

</div>

</body>
</html>