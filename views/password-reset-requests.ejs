<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#0f172a">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="VLCG HRMS">

    <title>Password Reset Requests - VLCG HRMS</title>
    <link rel="stylesheet" href="/css/style.css">

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #f3f6fb;
            font-family: Arial, sans-serif;
            color: #111827;
        }

        .app-layout {
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            width: 250px;
            background: #0f172a;
            color: #ffffff;
            padding: 22px 18px;
            position: fixed;
            left: 0;
            top: 0;
            bottom: 0;
            overflow-y: auto;
            z-index: 1000;
        }

        .sidebar h2 {
            margin: 0 0 24px;
            font-size: 24px;
        }

        .sidebar nav {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .sidebar nav a {
            color: #e5e7eb;
            text-decoration: none;
            padding: 11px 12px;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 500;
        }

        .sidebar nav a:hover,
        .sidebar nav a.active {
            background: #1e293b;
            color: #ffffff;
        }

        .content {
            margin-left: 250px;
            width: calc(100% - 250px);
            padding: 24px;
        }

        .mobile-topbar {
            display: none;
            background: #0f172a;
            color: #ffffff;
            padding: 14px 16px;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 900;
        }

        .mobile-topbar h2 {
            margin: 0;
            font-size: 18px;
        }

        .menu-toggle {
            border: none;
            background: #1e293b;
            color: #ffffff;
            padding: 9px 14px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
        }

        .sidebar-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, 0.55);
            z-index: 950;
        }

        .page-header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 16px;
            margin-bottom: 22px;
        }

        .page-header h1 {
            margin: 0;
            font-size: 30px;
        }

        .page-header p {
            margin: 7px 0 0;
            color: #6b7280;
            font-size: 14px;
        }

        .role-badge {
            background: #ffffff;
            border-radius: 12px;
            padding: 10px 14px;
            box-shadow: 0 2px 8px rgba(15, 23, 42, 0.08);
            font-size: 14px;
            color: #374151;
            white-space: nowrap;
        }

        .role-pill {
            display: inline-block;
            margin-left: 6px;
            background: #dbeafe;
            color: #1d4ed8;
            padding: 5px 9px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 700;
        }

        .card {
            background: #ffffff;
            border-radius: 16px;
            padding: 18px;
            box-shadow: 0 4px 14px rgba(15, 23, 42, 0.08);
            margin-bottom: 22px;
        }

        .section-title {
            margin: 0 0 14px;
            font-size: 22px;
            color: #111827;
        }

        .help-box {
            background: #eff6ff;
            color: #1e40af;
            border: 1px solid #bfdbfe;
            padding: 13px 14px;
            border-radius: 12px;
            font-size: 14px;
            margin-bottom: 16px;
            line-height: 1.5;
        }

        .help-box strong {
            color: #1e3a8a;
        }

        .table-wrap {
            width: 100%;
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 1100px;
            background: #ffffff;
        }

        th,
        td {
            text-align: left;
            padding: 12px 10px;
            border-bottom: 1px solid #e5e7eb;
            font-size: 14px;
            vertical-align: top;
        }

        th {
            background: #f8fafc;
            color: #374151;
            font-weight: 700;
        }

        .request-id {
            font-weight: 700;
            color: #6b7280;
        }

        .username-text {
            font-weight: 700;
            color: #111827;
        }

        .type-pill {
            display: inline-block;
            background: #eef2ff;
            color: #3730a3;
            padding: 6px 10px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 700;
        }

        .status-badge {
            display: inline-block;
            padding: 5px 9px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 700;
        }

        .status-pending {
            background: #fef3c7;
            color: #92400e;
        }

        .status-completed,
        .status-handled {
            background: #dcfce7;
            color: #166534;
        }

        .status-default {
            background: #e5e7eb;
            color: #374151;
        }

        .message-text {
            max-width: 300px;
            color: #374151;
            line-height: 1.4;
        }

        .primary-btn {
            border: none;
            border-radius: 10px;
            padding: 10px 13px;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            background: #2563eb;
            color: #ffffff;
            white-space: nowrap;
        }

        .primary-btn:hover {
            background: #1d4ed8;
        }

        .completed-text {
            display: inline-block;
            background: #e5e7eb;
            color: #374151;
            padding: 7px 10px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 700;
        }

        .empty-text {
            color: #6b7280;
        }

        @media (max-width: 768px) {
            .mobile-topbar {
                display: flex;
            }

            .app-layout {
                display: block;
            }

            .sidebar {
                transform: translateX(-100%);
                transition: transform 0.25s ease;
                width: 280px;
            }

            .sidebar.open {
                transform: translateX(0);
            }

            .sidebar-overlay.show {
                display: block;
            }

            .content {
                margin-left: 0;
                width: 100%;
                padding: 18px 14px 26px;
            }

            .page-header {
                flex-direction: column;
                align-items: flex-start;
            }

            .page-header h1 {
                font-size: 26px;
            }

            .role-badge {
                width: 100%;
                white-space: normal;
            }

            .card {
                padding: 16px;
                border-radius: 14px;
            }
        }
    </style>
</head>
<body>

<div class="mobile-topbar">
    <button type="button" class="menu-toggle" id="menuToggle">
        Menu
    </button>

    <h2>VLCG HRMS</h2>
</div>

<div class="sidebar-overlay" id="sidebarOverlay"></div>

<div class="app-layout">

    <aside class="sidebar" id="sidebar">
        <h2>HRMS</h2>

        <nav>
            <a href="/dashboard">Dashboard</a>

            <% if (user && (user.role === "Super Admin" || user.role === "HR")) { %>
                <a href="/employees">Employees</a>
                <a href="/password-reset-requests" class="active">Password Reset Requests</a>
            <% } %>

            <% if (user && (user.role === "Super Admin" || user.role === "HR" || user.role === "Manager")) { %>
                <a href="/attendance">Attendance</a>
                <a href="/attendance/monthly-report">Monthly Report</a>
                <a href="/attendance/regularizations">Regularizations</a>
                <a href="/leaves">Leaves</a>
                <a href="/leaves/balances">Leave Balances</a>
            <% } %>

            <% if (user && user.role === "Super Admin") { %>
                <a href="/payroll">Payroll</a>
                <a href="/admin-users">Admin Users</a>
                <a href="/company-settings">Company Settings</a>
                <a href="/activity-logs">Activity Logs</a>
                <a href="/export/backup">Download Backup</a>
            <% } %>

            <a href="/change-password">Change Password</a>
            <a href="/logout">Logout</a>
        </nav>
    </aside>

    <main class="content">

        <div class="page-header">
            <div>
                <h1>Password Reset Requests</h1>
                <p>Review password reset requests from admins, HR, managers, and employees.</p>
            </div>

            <div class="role-badge">
                Logged in as
                <strong><%= user && user.username ? user.username : "User" %></strong>

                <% if (user && user.role) { %>
                    <span class="role-pill"><%= user.role %></span>
                <% } %>
            </div>
        </div>

        <div class="card">
            <h2 class="section-title">Reset Request List</h2>

            <div class="help-box">
                Use <strong>Admin Users</strong> to reset Admin/HR/Manager passwords.
                Use <strong>Employees → Reset Login</strong> to reset employee passwords.
                After resetting, mark the request as handled.
            </div>

            <div class="table-wrap">
                <table>
                    <tr>
                        <th>ID</th>
                        <th>User Type</th>
                        <th>Username</th>
                        <th>Email</th>
                        <th>Message</th>
                        <th>Status</th>
                        <th>Handled By</th>
                        <th>Created</th>
                        <th>Action</th>
                    </tr>

                    <% if (requests && requests.length > 0) { %>
                        <% requests.forEach(request => { %>
                            <tr>
                                <td>
                                    <span class="request-id">
                                        #<%= request.id %>
                                    </span>
                                </td>

                                <td>
                                    <span class="type-pill">
                                        <%= request.user_type || "-" %>
                                    </span>
                                </td>

                                <td>
                                    <span class="username-text">
                                        <%= request.username || "-" %>
                                    </span>
                                </td>

                                <td><%= request.email || "-" %></td>

                                <td>
                                    <div class="message-text">
                                        <%= request.message || "-" %>
                                    </div>
                                </td>

                                <td>
                                    <% if (request.status === "Pending") { %>
                                        <span class="status-badge status-pending">Pending</span>
                                    <% } else if (request.status === "Completed" || request.status === "Handled") { %>
                                        <span class="status-badge status-handled"><%= request.status %></span>
                                    <% } else { %>
                                        <span class="status-badge status-default"><%= request.status || "-" %></span>
                                    <% } %>
                                </td>

                                <td><%= request.handled_by || "-" %></td>

                                <td>
                                    <%= request.created_at ? new Date(request.created_at).toLocaleString() : "-" %>
                                </td>

                                <td>
                                    <% if (request.status === "Pending") { %>
                                        <form action="/password-reset-requests/mark-handled/<%= request.id %>" method="POST">
                                            <button type="submit" class="primary-btn">
                                                Mark Handled
                                            </button>
                                        </form>
                                    <% } else { %>
                                        <span class="completed-text">Completed</span>
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="9" class="empty-text">
                                No password reset requests found.
                            </td>
                        </tr>
                    <% } %>
                </table>
            </div>

        </div>

    </main>

</div>

<script>
    const menuToggle = document.getElementById("menuToggle");
    const sidebar = document.getElementById("sidebar");
    const sidebarOverlay = document.getElementById("sidebarOverlay");

    function openSidebar() {
        sidebar.classList.add("open");
        sidebarOverlay.classList.add("show");
    }

    function closeSidebar() {
        sidebar.classList.remove("open");
        sidebarOverlay.classList.remove("show");
    }

    if (menuToggle) {
        menuToggle.addEventListener("click", openSidebar);
    }

    if (sidebarOverlay) {
        sidebarOverlay.addEventListener("click", closeSidebar);
    }

    document.querySelectorAll(".sidebar nav a").forEach(function (link) {
        link.addEventListener("click", closeSidebar);
    });

    if ("serviceWorker" in navigator) {
        window.addEventListener("load", function () {
            navigator.serviceWorker.register("/service-worker.js")
                .then(function () {
                    console.log("VLCG HRMS service worker registered");
                })
                .catch(function (error) {
                    console.log("Service worker registration failed:", error);
                });
        });
    }
</script>

</body>
</html>