<!DOCTYPE html>
<html>
<head>
    <title>Password Reset Requests</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<div class="app-layout">

    <aside class="sidebar">
        <h2>HRMS</h2>

        <nav>
            <a href="/dashboard">Dashboard</a>

            <% if (user && (user.role === "Super Admin" || user.role === "HR")) { %>
                <a href="/employees">Employees</a>
                <a href="/password-reset-requests">Password Reset Requests</a>
            <% } %>

            <% if (user && (user.role === "Super Admin" || user.role === "HR" || user.role === "Manager")) { %>
                <a href="/attendance">Attendance</a>
                <a href="/attendance/monthly-report">Monthly Report</a>
                <a href="/attendance/regularizations">Regularizations</a>
                <a href="/leaves">Leaves</a>
                <a href="/leaves/balances">Leave Balances</a>
            <% } %>

            <% if (user && user.role === "Super Admin") { %>
                <a href="/payroll">Payroll</a>
                <a href="/admin-users">Admin Users</a>
                <a href="/company-settings">Company Settings</a>
                <a href="/activity-logs">Activity Logs</a>
                <a href="/export/backup">Download Backup</a>
            <% } %>

            <a href="/change-password">Change Password</a>
            <a href="/logout">Logout</a>
        </nav>
    </aside>

    <main class="content">

        <h1>Password Reset Requests</h1>

        <table>
            <tr>
                <th>ID</th>
                <th>User Type</th>
                <th>Username</th>
                <th>Email</th>
                <th>Message</th>
                <th>Status</th>
                <th>Handled By</th>
                <th>Created</th>
                <th>Action</th>
            </tr>

            <% if (requests && requests.length > 0) { %>
                <% requests.forEach(request => { %>
                    <tr>
                        <td><%= request.id %></td>
                        <td><%= request.user_type || '-' %></td>
                        <td><%= request.username || '-' %></td>
                        <td><%= request.email || '-' %></td>
                        <td><%= request.message || '-' %></td>
                        <td><%= request.status || '-' %></td>
                        <td><%= request.handled_by || '-' %></td>
                        <td><%= request.created_at ? new Date(request.created_at).toLocaleString() : '-' %></td>

                        <td>
                            <% if (request.status === 'Pending') { %>
                                <form action="/password-reset-requests/mark-handled/<%= request.id %>" method="POST">
                                    <button type="submit">Mark Handled</button>
                                </form>
                            <% } else { %>
                                Completed
                            <% } %>
                        </td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="9">No password reset requests found.</td>
                </tr>
            <% } %>
        </table>

        <br>

        <p>
            Use <strong>Admin Users</strong> to reset Admin/HR/Manager passwords.
            Use <strong>Employees → Reset Login</strong> to reset employee passwords.
        </p>

    </main>

</div>

</body>
</html>