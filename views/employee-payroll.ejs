<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#0f172a">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="VLCG HRMS">

    <title>Employee Payroll - VLCG HRMS</title>
    <link rel="stylesheet" href="/css/style.css">

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #f3f6fb;
            font-family: Arial, sans-serif;
            color: #111827;
        }

        .app-layout {
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            width: 250px;
            background: #0f172a;
            color: #ffffff;
            padding: 22px 18px;
            position: fixed;
            left: 0;
            top: 0;
            bottom: 0;
            overflow-y: auto;
            z-index: 1000;
        }

        .sidebar h2 {
            margin: 0 0 24px;
            font-size: 22px;
        }

        .sidebar nav {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .sidebar nav a {
            color: #e5e7eb;
            text-decoration: none;
            padding: 11px 12px;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 500;
        }

        .sidebar nav a:hover,
        .sidebar nav a.active {
            background: #1e293b;
            color: #ffffff;
        }

        .content {
            margin-left: 250px;
            width: calc(100% - 250px);
            padding: 24px;
        }

        .mobile-topbar {
            display: none;
            background: #0f172a;
            color: #ffffff;
            padding: 14px 16px;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 900;
        }

        .mobile-topbar h2 {
            margin: 0;
            font-size: 18px;
        }

        .menu-toggle {
            border: none;
            background: #1e293b;
            color: #ffffff;
            padding: 9px 14px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
        }

        .sidebar-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, 0.55);
            z-index: 950;
        }

        .page-header {
            margin-bottom: 22px;
        }

        .page-header h1 {
            margin: 0;
            font-size: 30px;
        }

        .page-header p {
            margin: 7px 0 0;
            color: #6b7280;
            font-size: 14px;
        }

        .card {
            background: #ffffff;
            border-radius: 16px;
            padding: 20px;
            box-shadow: 0 4px 14px rgba(15, 23, 42, 0.08);
            margin-bottom: 22px;
        }

        .profile-card {
            display: flex;
            align-items: center;
            gap: 20px;
            background: linear-gradient(135deg, #ffffff, #eef6ff);
        }

        .profile-photo {
            width: 96px;
            height: 96px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid #ffffff;
            box-shadow: 0 5px 14px rgba(15, 23, 42, 0.18);
            background: #e5e7eb;
            flex-shrink: 0;
        }

        .profile-info h2 {
            margin: 0 0 10px;
            font-size: 24px;
            color: #111827;
        }

        .profile-info p {
            margin: 6px 0;
            color: #4b5563;
            font-size: 15px;
        }

        .salary-pill {
            margin-top: 12px;
            display: inline-block;
            background: #dcfce7;
            color: #166534;
            padding: 7px 11px;
            border-radius: 999px;
            font-size: 13px;
            font-weight: 700;
        }

        .toolbar-card {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            flex-wrap: wrap;
        }

        .month-form {
            display: flex;
            gap: 12px;
            align-items: center;
            flex-wrap: wrap;
            width: 100%;
        }

        .month-form input {
            min-width: 220px;
            flex: 1;
            padding: 13px;
            border: 1px solid #cbd5e1;
            border-radius: 10px;
            font-size: 15px;
            outline: none;
        }

        .month-form input:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
        }

        .primary-btn,
        .secondary-btn {
            border: none;
            border-radius: 10px;
            padding: 11px 14px;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            white-space: nowrap;
        }

        .primary-btn {
            background: #2563eb;
            color: #ffffff;
        }

        .primary-btn:hover {
            background: #1d4ed8;
        }

        .secondary-btn {
            background: #0f172a;
            color: #ffffff;
        }

        .secondary-btn:hover {
            background: #1e293b;
        }

        .summary-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(160px, 1fr));
            gap: 14px;
            margin-top: 16px;
        }

        .summary-item {
            background: #f8fafc;
            border: 1px solid #e5e7eb;
            border-radius: 14px;
            padding: 15px;
        }

        .summary-item span {
            display: block;
            color: #6b7280;
            font-size: 13px;
            margin-bottom: 7px;
        }

        .summary-item strong {
            display: block;
            color: #111827;
            font-size: 20px;
        }

        .final-salary {
            background: #dcfce7;
            border-color: #bbf7d0;
        }

        .final-salary strong {
            color: #166534;
        }

        .download-form {
            margin-top: 18px;
        }

        .section-title {
            margin: 0 0 14px;
            font-size: 22px;
            color: #111827;
        }

        .table-wrap {
            width: 100%;
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 860px;
            background: #ffffff;
        }

        th,
        td {
            text-align: left;
            padding: 12px 10px;
            border-bottom: 1px solid #e5e7eb;
            font-size: 14px;
            vertical-align: top;
        }

        th {
            background: #f8fafc;
            color: #374151;
            font-weight: 700;
        }

        .amount-strong {
            font-weight: 700;
            color: #166534;
        }

        @media (max-width: 1000px) {
            .summary-grid {
                grid-template-columns: repeat(2, minmax(160px, 1fr));
            }
        }

        @media (max-width: 768px) {
            .mobile-topbar {
                display: flex;
            }

            .app-layout {
                display: block;
            }

            .sidebar {
                transform: translateX(-100%);
                transition: transform 0.25s ease;
                width: 280px;
            }

            .sidebar.open {
                transform: translateX(0);
            }

            .sidebar-overlay.show {
                display: block;
            }

            .content {
                margin-left: 0;
                width: 100%;
                padding: 18px 14px 26px;
            }

            .page-header h1 {
                font-size: 26px;
            }

            .card {
                padding: 16px;
                border-radius: 14px;
            }

            .profile-card {
                align-items: flex-start;
            }

            .profile-photo {
                width: 76px;
                height: 76px;
            }

            .profile-info h2 {
                font-size: 21px;
            }

            .profile-info p {
                font-size: 14px;
            }

            .month-form {
                flex-direction: column;
                align-items: stretch;
            }

            .month-form input,
            .primary-btn,
            .secondary-btn {
                width: 100%;
            }

            .summary-grid {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 420px) {
            .profile-card {
                flex-direction: column;
                text-align: center;
                align-items: center;
            }
        }
    </style>
</head>
<body>

<div class="mobile-topbar">
    <button type="button" class="menu-toggle" id="menuToggle">
        Menu
    </button>

    <h2>Employee Portal</h2>
</div>

<div class="sidebar-overlay" id="sidebarOverlay"></div>

<div class="app-layout">

    <aside class="sidebar" id="sidebar">
        <h2>Employee Portal</h2>

        <nav>
            <a href="/employee/dashboard">Dashboard</a>
            <a href="/employee/notifications">Notifications</a>
            <a href="/employee/leaves">Leaves</a>
            <a href="/employee/payroll" class="active">Payroll</a>
            <a href="/employee/regularizations">Regularization</a>
            <a href="/employee/change-password">Change Password</a>
            <a href="/employee/logout">Logout</a>
        </nav>
    </aside>

    <main class="content">

        <div class="page-header">
            <h1>Your Payroll</h1>
            <p>Calculate current payslip, view salary details, and download payroll PDFs.</p>
        </div>

        <div class="card profile-card">
            <img
                src="<%= photoUrl %>"
                alt="<%= employee && employee.name ? employee.name : 'Employee' %>"
                class="profile-photo"
            >

            <div class="profile-info">
                <h2><%= employee && employee.name ? employee.name : "Employee" %></h2>

                <p>
                    <strong>Department:</strong>
                    <%= employee && employee.department ? employee.department : "-" %>
                </p>

                <p>
                    <strong>Designation:</strong>
                    <%= employee && employee.designation ? employee.designation : "-" %>
                </p>

                <span class="salary-pill">
                    Monthly Salary: Rs. <%= employee && employee.salary ? employee.salary : 0 %>
                </span>
            </div>
        </div>

        <div class="card toolbar-card">
            <form action="/employee/payroll/calculate" method="POST" class="month-form">
                <input type="month" name="month" required>

                <button type="submit" class="primary-btn">
                    Calculate Current Payslip
                </button>
            </form>
        </div>

        <% if (payroll) { %>
            <div class="card">
                <h2 class="section-title">Calculated Payslip Summary</h2>

                <div class="summary-grid">
                    <div class="summary-item">
                        <span>Month</span>
                        <strong><%= payroll.month %></strong>
                    </div>

                    <div class="summary-item">
                        <span>Present Days</span>
                        <strong><%= payroll.present || 0 %></strong>
                    </div>

                    <div class="summary-item">
                        <span>Absent Days</span>
                        <strong><%= payroll.absent || 0 %></strong>
                    </div>

                    <div class="summary-item">
                        <span>Half Days</span>
                        <strong><%= payroll.halfday || 0 %></strong>
                    </div>

                    <div class="summary-item">
                        <span>Deductions</span>
                        <strong>Rs. <%= Number(payroll.deduction || 0).toFixed(2) %></strong>
                    </div>

                    <div class="summary-item final-salary">
                        <span>Final Salary</span>
                        <strong>Rs. <%= Number(payroll.finalSalary || 0).toFixed(2) %></strong>
                    </div>
                </div>

                <form action="/payroll/payslip" method="POST" class="download-form">

                    <input type="hidden" name="employeeName" value="<%= employee.name %>">
                    <input type="hidden" name="department" value="<%= employee.department %>">
                    <input type="hidden" name="salary" value="<%= employee.salary %>">
                    <input type="hidden" name="present" value="<%= payroll.present %>">
                    <input type="hidden" name="absent" value="<%= payroll.absent %>">
                    <input type="hidden" name="halfday" value="<%= payroll.halfday %>">
                    <input type="hidden" name="deduction" value="<%= Number(payroll.deduction || 0).toFixed(2) %>">
                    <input type="hidden" name="finalSalary" value="<%= Number(payroll.finalSalary || 0).toFixed(2) %>">
                    <input type="hidden" name="month" value="<%= payroll.month %>">
                    <input type="hidden" name="photo_path" value="<%= employee.photo_path || '' %>">

                    <button type="submit" class="secondary-btn">
                        Download PDF Payslip
                    </button>

                </form>
            </div>
        <% } %>

        <div class="card">
            <h2 class="section-title">Saved Payroll History</h2>

            <div class="table-wrap">
                <table>
                    <tr>
                        <th>Month</th>
                        <th>Base Salary</th>
                        <th>Present</th>
                        <th>Absent</th>
                        <th>Half Days</th>
                        <th>Deduction</th>
                        <th>Final Salary</th>
                        <th>PDF</th>
                    </tr>

                    <% if (records && records.length > 0) { %>
                        <% records.forEach(record => { %>
                            <tr>
                                <td><%= record.month || "-" %></td>
                                <td>Rs. <%= record.base_salary || 0 %></td>
                                <td><%= record.present_days || 0 %></td>
                                <td><%= record.absent_days || 0 %></td>
                                <td><%= record.half_days || 0 %></td>
                                <td>Rs. <%= Number(record.deduction || 0).toFixed(2) %></td>
                                <td class="amount-strong">
                                    Rs. <%= Number(record.final_salary || 0).toFixed(2) %>
                                </td>
                                <td>
                                    <form action="/payroll/payslip" method="POST">
                                        <input type="hidden" name="employeeName" value="<%= employee.name %>">
                                        <input type="hidden" name="department" value="<%= employee.department %>">
                                        <input type="hidden" name="salary" value="<%= record.base_salary %>">
                                        <input type="hidden" name="present" value="<%= record.present_days %>">
                                        <input type="hidden" name="absent" value="<%= record.absent_days %>">
                                        <input type="hidden" name="halfday" value="<%= record.half_days %>">
                                        <input type="hidden" name="deduction" value="<%= Number(record.deduction || 0).toFixed(2) %>">
                                        <input type="hidden" name="finalSalary" value="<%= Number(record.final_salary || 0).toFixed(2) %>">
                                        <input type="hidden" name="month" value="<%= record.month %>">
                                        <input type="hidden" name="photo_path" value="<%= employee.photo_path || '' %>">

                                        <button type="submit" class="secondary-btn">
                                            PDF
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="8">No saved payroll records yet.</td>
                        </tr>
                    <% } %>

                </table>
            </div>
        </div>

    </main>

</div>

<script>
    const menuToggle = document.getElementById("menuToggle");
    const sidebar = document.getElementById("sidebar");
    const sidebarOverlay = document.getElementById("sidebarOverlay");

    function openSidebar() {
        sidebar.classList.add("open");
        sidebarOverlay.classList.add("show");
    }

    function closeSidebar() {
        sidebar.classList.remove("open");
        sidebarOverlay.classList.remove("show");
    }

    if (menuToggle) {
        menuToggle.addEventListener("click", openSidebar);
    }

    if (sidebarOverlay) {
        sidebarOverlay.addEventListener("click", closeSidebar);
    }

    document.querySelectorAll(".sidebar nav a").forEach(function (link) {
        link.addEventListener("click", closeSidebar);
    });

    if ("serviceWorker" in navigator) {
        window.addEventListener("load", function () {
            navigator.serviceWorker.register("/service-worker.js")
                .then(function () {
                    console.log("VLCG HRMS service worker registered");
                })
                .catch(function (error) {
                    console.log("Service worker registration failed:", error);
                });
        });
    }
</script>

</body>
</html>