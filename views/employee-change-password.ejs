<!DOCTYPE html>
<html>
<head>
    <title>Employee Change Password</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<div class="app-layout">

    <aside class="sidebar">
        <h2>Employee Portal</h2>

        <nav>
            <a href="/employee/dashboard">Dashboard</a>
            <a href="/employee/leaves">Leaves</a>
            <a href="/employee/payroll">Payroll</a>
            <a href="/employee/regularizations">Regularization</a>
            <a href="/employee/change-password">Change Password</a>
            <a href="/employee/logout">Logout</a>
        </nav>
    </aside>

    <main class="content">

        <h1>Change Password</h1>

        <div class="card">

            <% if (error) { %>
                <p style="color:red;"><%= error %></p>
            <% } %>

            <% if (success) { %>
                <p style="color:green;"><%= success %></p>
            <% } %>

            <form action="/employee/change-password" method="POST" class="stack-form">

                <label>Current Password</label>
                <input type="password" name="current_password" required>

                <label>New Password</label>
                <input type="password" name="new_password" required>

                <label>Confirm New Password</label>
                <input type="password" name="confirm_password" required>

                <button type="submit">
                    Change Password
                </button>

            </form>

        </div>

    </main>

</div>

</body>
</html>