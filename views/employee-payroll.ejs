<!DOCTYPE html>
<html>
<head>
    <title>Employee Payroll</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<div class="app-layout">

    <aside class="sidebar">
        <h2>Employee Portal</h2>

        <nav>
            <a href="/employee/dashboard">Dashboard</a>
            <a href="/employee/leaves">Leaves</a>
            <a href="/employee/payroll">Payroll</a>
            <a href="/employee/logout">Logout</a>
        </nav>
    </aside>

    <main class="content">

        <h1>Your Payroll</h1>

        <div class="card">
            <p><strong>Name:</strong> <%= employee.name %></p>
            <p><strong>Department:</strong> <%= employee.department %></p>
            <p><strong>Monthly Salary:</strong> ₹ <%= employee.salary %></p>
        </div>

        <br>

        <form action="/employee/payroll/calculate" method="POST" class="toolbar">
            <input type="month" name="month" required>
            <button type="submit">Calculate Current Payslip</button>
        </form>

        <% if (payroll) { %>

        <div class="card">
            <h2>Calculated Payslip Summary</h2>

            <br>

            <p><strong>Month:</strong> <%= payroll.month %></p>
            <p><strong>Present Days:</strong> <%= payroll.present %></p>
            <p><strong>Absent Days:</strong> <%= payroll.absent %></p>
            <p><strong>Half Days:</strong> <%= payroll.halfday %></p>
            <p><strong>Deductions:</strong> ₹ <%= payroll.deduction.toFixed(2) %></p>
            <p><strong>Final Salary:</strong> ₹ <%= payroll.finalSalary.toFixed(2) %></p>

            <br>

            <form action="/payroll/payslip" method="POST">

                <input type="hidden" name="employeeName" value="<%= employee.name %>">
                <input type="hidden" name="department" value="<%= employee.department %>">
                <input type="hidden" name="salary" value="<%= employee.salary %>">
                <input type="hidden" name="present" value="<%= payroll.present %>">
                <input type="hidden" name="absent" value="<%= payroll.absent %>">
                <input type="hidden" name="halfday" value="<%= payroll.halfday %>">
                <input type="hidden" name="deduction" value="<%= payroll.deduction.toFixed(2) %>">
                <input type="hidden" name="finalSalary" value="<%= payroll.finalSalary.toFixed(2) %>">
                <input type="hidden" name="month" value="<%= payroll.month %>">

                <button type="submit">Download PDF Payslip</button>

            </form>
        </div>

        <br>

        <% } %>

        <h2>Saved Payroll History</h2>

        <br>

        <table>
            <tr>
                <th>Month</th>
                <th>Base Salary</th>
                <th>Present</th>
                <th>Absent</th>
                <th>Half Days</th>
                <th>Deduction</th>
                <th>Final Salary</th>
                <th>PDF</th>
            </tr>

            <% if (records && records.length > 0) { %>
                <% records.forEach(record => { %>
                <tr>
                    <td><%= record.month %></td>
                    <td>₹ <%= record.base_salary %></td>
                    <td><%= record.present_days %></td>
                    <td><%= record.absent_days %></td>
                    <td><%= record.half_days %></td>
                    <td>₹ <%= Number(record.deduction).toFixed(2) %></td>
                    <td>₹ <%= Number(record.final_salary).toFixed(2) %></td>
                    <td>
                        <form action="/payroll/payslip" method="POST">
                            <input type="hidden" name="employeeName" value="<%= employee.name %>">
                            <input type="hidden" name="department" value="<%= employee.department %>">
                            <input type="hidden" name="salary" value="<%= record.base_salary %>">
                            <input type="hidden" name="present" value="<%= record.present_days %>">
                            <input type="hidden" name="absent" value="<%= record.absent_days %>">
                            <input type="hidden" name="halfday" value="<%= record.half_days %>">
                            <input type="hidden" name="deduction" value="<%= Number(record.deduction).toFixed(2) %>">
                            <input type="hidden" name="finalSalary" value="<%= Number(record.final_salary).toFixed(2) %>">
                            <input type="hidden" name="month" value="<%= record.month %>">

                            <button type="submit">PDF</button>
                        </form>
                    </td>
                </tr>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="8">No saved payroll records yet.</td>
                </tr>
            <% } %>

        </table>

    </main>

</div>

</body>
</html>