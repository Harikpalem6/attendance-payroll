<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#0f172a">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="VLCG HRMS">

    <title>Attendance Regularization - VLCG HRMS</title>
    <link rel="stylesheet" href="/css/style.css">

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #f3f6fb;
            font-family: Arial, sans-serif;
            color: #111827;
        }

        .app-layout {
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            width: 250px;
            background: #0f172a;
            color: #ffffff;
            padding: 22px 18px;
            position: fixed;
            left: 0;
            top: 0;
            bottom: 0;
            overflow-y: auto;
            z-index: 1000;
        }

        .sidebar h2 {
            margin: 0 0 24px;
            font-size: 22px;
        }

        .sidebar nav {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .sidebar nav a {
            color: #e5e7eb;
            text-decoration: none;
            padding: 11px 12px;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 500;
        }

        .sidebar nav a:hover,
        .sidebar nav a.active {
            background: #1e293b;
            color: #ffffff;
        }

        .content {
            margin-left: 250px;
            width: calc(100% - 250px);
            padding: 24px;
        }

        .mobile-topbar {
            display: none;
            background: #0f172a;
            color: #ffffff;
            padding: 14px 16px;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 900;
        }

        .mobile-topbar h2 {
            margin: 0;
            font-size: 18px;
        }

        .menu-toggle {
            border: none;
            background: #1e293b;
            color: #ffffff;
            padding: 9px 14px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
        }

        .sidebar-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, 0.55);
            z-index: 950;
        }

        .page-header {
            margin-bottom: 22px;
        }

        .page-header h1 {
            margin: 0;
            font-size: 30px;
        }

        .page-header p {
            margin: 7px 0 0;
            color: #6b7280;
            font-size: 14px;
        }

        .card {
            background: #ffffff;
            border-radius: 16px;
            padding: 20px;
            box-shadow: 0 4px 14px rgba(15, 23, 42, 0.08);
            margin-bottom: 22px;
        }

        .card h2 {
            margin: 0 0 16px;
            font-size: 20px;
        }

        .stack-form {
            display: grid;
            grid-template-columns: repeat(2, minmax(180px, 1fr));
            gap: 14px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 7px;
        }

        .form-group.full-width {
            grid-column: 1 / -1;
        }

        label {
            font-size: 14px;
            font-weight: 700;
            color: #374151;
        }

        .stack-form input,
        .stack-form select {
            width: 100%;
            padding: 13px;
            border: 1px solid #cbd5e1;
            border-radius: 10px;
            font-size: 15px;
            outline: none;
            background: #ffffff;
        }

        .stack-form input:focus,
        .stack-form select:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
        }

        .submit-btn {
            grid-column: 1 / -1;
            border: none;
            background: #2563eb;
            color: #ffffff;
            padding: 13px 16px;
            border-radius: 10px;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
        }

        .submit-btn:hover {
            background: #1d4ed8;
        }

        .section-title {
            margin: 0 0 14px;
            font-size: 22px;
            color: #111827;
        }

        .table-wrap {
            width: 100%;
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 980px;
            background: #ffffff;
        }

        th,
        td {
            text-align: left;
            padding: 12px 10px;
            border-bottom: 1px solid #e5e7eb;
            font-size: 14px;
            vertical-align: top;
        }

        th {
            background: #f8fafc;
            color: #374151;
            font-weight: 700;
        }

        .status-badge {
            display: inline-block;
            padding: 5px 9px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 700;
        }

        .status-approved {
            background: #dcfce7;
            color: #166534;
        }

        .status-rejected {
            background: #fee2e2;
            color: #991b1b;
        }

        .status-pending {
            background: #fef3c7;
            color: #92400e;
        }

        .status-default {
            background: #e5e7eb;
            color: #374151;
        }

        .help-box {
            background: #eff6ff;
            color: #1e40af;
            border: 1px solid #bfdbfe;
            padding: 13px 14px;
            border-radius: 12px;
            font-size: 14px;
            margin-bottom: 16px;
        }

        @media (max-width: 900px) {
            .stack-form {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 768px) {
            .mobile-topbar {
                display: flex;
            }

            .app-layout {
                display: block;
            }

            .sidebar {
                transform: translateX(-100%);
                transition: transform 0.25s ease;
                width: 280px;
            }

            .sidebar.open {
                transform: translateX(0);
            }

            .sidebar-overlay.show {
                display: block;
            }

            .content {
                margin-left: 0;
                width: 100%;
                padding: 18px 14px 26px;
            }

            .page-header h1 {
                font-size: 26px;
            }

            .card {
                padding: 16px;
                border-radius: 14px;
            }
        }
    </style>
</head>
<body>

<div class="mobile-topbar">
    <button type="button" class="menu-toggle" id="menuToggle">
        Menu
    </button>

    <h2>Employee Portal</h2>
</div>

<div class="sidebar-overlay" id="sidebarOverlay"></div>

<div class="app-layout">

    <aside class="sidebar" id="sidebar">
        <h2>Employee Portal</h2>

        <nav>
            <a href="/employee/dashboard">Dashboard</a>
            <a href="/employee/leaves">Leaves</a>
            <a href="/employee/payroll">Payroll</a>
            <a href="/employee/regularizations" class="active">Regularization</a>
            <a href="/employee/change-password">Change Password</a>
            <a href="/employee/logout">Logout</a>
        </nav>
    </aside>

    <main class="content">

        <div class="page-header">
            <h1>Attendance Regularization</h1>
            <p>Request correction for missed check-in, missed check-out, or incorrect attendance status.</p>
        </div>

        <div class="card">
            <h2>Submit Request</h2>

            <div class="help-box">
                Use this form only when your attendance is missing or incorrect. HR/Admin will review and approve or reject your request.
            </div>

            <form action="/employee/regularizations/apply" method="POST" class="stack-form">

                <div class="form-group">
                    <label>Attendance Date</label>
                    <input type="date" name="attendance_date" required>
                </div>

                <div class="form-group">
                    <label>Requested Status</label>
                    <select name="requested_status" required>
                        <option value="Present">Present</option>
                        <option value="Absent">Absent</option>
                        <option value="Half Day">Half Day</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Requested Check In</label>
                    <input type="time" name="requested_check_in">
                </div>

                <div class="form-group">
                    <label>Requested Check Out</label>
                    <input type="time" name="requested_check_out">
                </div>

                <div class="form-group full-width">
                    <label>Reason</label>
                    <input
                        type="text"
                        name="reason"
                        placeholder="Example: Forgot to check in"
                        required
                    >
                </div>

                <button type="submit" class="submit-btn">
                    Submit Request
                </button>

            </form>
        </div>

        <div class="card">
            <h2 class="section-title">Your Requests</h2>

            <div class="table-wrap">
                <table>
                    <tr>
                        <th>ID</th>
                        <th>Date</th>
                        <th>Requested Status</th>
                        <th>Check In</th>
                        <th>Check Out</th>
                        <th>Reason</th>
                        <th>Status</th>
                        <th>Admin Remarks</th>
                        <th>Created</th>
                    </tr>

                    <% if (requests && requests.length > 0) { %>
                        <% requests.forEach(request => { %>
                            <tr>
                                <td><%= request.id %></td>

                                <td>
                                    <%= request.attendance_date ? new Date(request.attendance_date).toLocaleDateString() : "-" %>
                                </td>

                                <td><%= request.requested_status || "-" %></td>

                                <td><%= request.requested_check_in || "-" %></td>

                                <td><%= request.requested_check_out || "-" %></td>

                                <td><%= request.reason || "-" %></td>

                                <td>
                                    <% if (request.status === "Approved") { %>
                                        <span class="status-badge status-approved">Approved</span>
                                    <% } else if (request.status === "Rejected") { %>
                                        <span class="status-badge status-rejected">Rejected</span>
                                    <% } else if (request.status === "Pending") { %>
                                        <span class="status-badge status-pending">Pending</span>
                                    <% } else { %>
                                        <span class="status-badge status-default"><%= request.status || "-" %></span>
                                    <% } %>
                                </td>

                                <td><%= request.admin_remarks || "-" %></td>

                                <td>
                                    <%= request.created_at ? new Date(request.created_at).toLocaleString() : "-" %>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="9">No regularization requests found.</td>
                        </tr>
                    <% } %>
                </table>
            </div>
        </div>

    </main>

</div>

<script>
    const menuToggle = document.getElementById("menuToggle");
    const sidebar = document.getElementById("sidebar");
    const sidebarOverlay = document.getElementById("sidebarOverlay");

    function openSidebar() {
        sidebar.classList.add("open");
        sidebarOverlay.classList.add("show");
    }

    function closeSidebar() {
        sidebar.classList.remove("open");
        sidebarOverlay.classList.remove("show");
    }

    if (menuToggle) {
        menuToggle.addEventListener("click", openSidebar);
    }

    if (sidebarOverlay) {
        sidebarOverlay.addEventListener("click", closeSidebar);
    }

    document.querySelectorAll(".sidebar nav a").forEach(function (link) {
        link.addEventListener("click", closeSidebar);
    });

    if ("serviceWorker" in navigator) {
        window.addEventListener("load", function () {
            navigator.serviceWorker.register("/service-worker.js")
                .then(function () {
                    console.log("VLCG HRMS service worker registered");
                })
                .catch(function (error) {
                    console.log("Service worker registration failed:", error);
                });
        });
    }
</script>

</body>
</html>